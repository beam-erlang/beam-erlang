# Resolve the prefix at install time so --prefix and DESTDIR both work.
include("@CMAKE_CURRENT_LIST_DIR@/cmake/StageDestDir.cmake")
set(_bindir "@CMAKE_INSTALL_BINDIR@")
if(NOT IS_ABSOLUTE "${_bindir}")
    set(_bindir "${CMAKE_INSTALL_PREFIX}/${_bindir}")
endif()
erts_staged_path("$ENV{DESTDIR}" "${_bindir}" _staged_bindir)
set(_windows @ERTS_WINDOWS_INSTALL@)
set(_flavor "@ERTS_BUILD_FLAVOR@")
if(_windows)
    # Windows flavor names are copies of beam.exe. DESTDIR follows CMake:
    # the drive letter is removed from the prefix, then DESTDIR is prepended.
    set(_aliases "beam.smp.exe" "beam.${_flavor}.exe")
    foreach(_alias IN LISTS _aliases)
        file(COPY_FILE "${_staged_bindir}/beam.exe" "${_staged_bindir}/${_alias}")
        erts_install_manifest_path("${_bindir}/${_alias}" _manifest_path)
        list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${_manifest_path}")
    endforeach()
    if("@CMAKE_BUILD_TYPE@" STREQUAL "Debug")
        foreach(_alias IN ITEMS "beam.smp.pdb" "beam.${_flavor}.pdb")
            file(COPY_FILE "${_staged_bindir}/beam.pdb" "${_staged_bindir}/${_alias}")
            erts_install_manifest_path("${_bindir}/${_alias}" _manifest_path)
            list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${_manifest_path}")
        endforeach()
    endif()
else()
    set(_aliases beam.smp beam.${_flavor})
    if("@CMAKE_BUILD_TYPE@" STREQUAL "Debug")
        list(APPEND _aliases erl_child_setup.debug)
    endif()
    foreach(_alias IN LISTS _aliases)
        if(_alias STREQUAL "erl_child_setup.debug")
            set(_target erl_child_setup)
        else()
            set(_target beam)
        endif()
        file(CREATE_LINK "${_target}" "${_staged_bindir}/${_alias}" SYMBOLIC RESULT _result)
        if(NOT _result STREQUAL "0")
            message(FATAL_ERROR "Cannot install ${_alias}: ${_result}")
        endif()
        erts_install_manifest_path("${_bindir}/${_alias}" _manifest_path)
        list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${_manifest_path}")
    endforeach()
endif()
