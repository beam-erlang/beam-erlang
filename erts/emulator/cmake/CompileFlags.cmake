# erl_compile_flags.h, included by the BIF sources.

function(erts_configure_compile_flags_header target)
    if(NOT DEFINED EMULATOR_GENERATED_DIR)
        message(FATAL_ERROR "erts_configure_compile_flags_header requires EMULATOR_GENERATED_DIR")
    endif()

    file(MAKE_DIRECTORY ${EMULATOR_GENERATED_DIR})
    file(WRITE ${EMULATOR_GENERATED_DIR}/erl_compile_flags.h
"/* Generated by the beam-erlang build. */
#define ERTS_NO_RETPOLINE
#define HAVE_ERTS_INTERNAL 1
#define ERLANG_ARCHITECTURE \"${ERTS_HOST_TRIPLE}\"
char *erts_build_flags_CONFIG_H = \"(stub)\";
char *erts_build_flags_CFLAGS = \"(stub)\";
char *erts_build_flags_LDFLAGS = \"(stub)\";
")
    add_custom_target(compile_flags_${ERTS_BUILD_FLAVOR}
        DEPENDS ${EMULATOR_GENERATED_DIR}/erl_compile_flags.h)
    add_dependencies(${target} compile_flags_${ERTS_BUILD_FLAVOR})
endfunction()
