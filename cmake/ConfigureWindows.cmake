# Native Windows x64, MSVC. Kernel poll stays off. The I/O driver is
# sys/win32/erl_poll.c (WaitForMultipleObjects). Threads are the Win32
# ethread implementation, not pthreads.

if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "ConfigureWindows.cmake is for native Windows only")
endif()
if(NOT MSVC)
    message(FATAL_ERROR "Windows builds require MSVC")
endif()

if(SIZEOF_OFF_T EQUAL 0)
    # MSVC has no off_t unless a POSIX shim is included. The Win32 file
    # layer does not use this width.
    set(SIZEOF_OFF_T 4)
endif()
set(SIZEOF__FLOAT16 0)
if(SIZEOF___INT64 EQUAL 0)
    set(SIZEOF___INT64 8)
endif()

set(ETHR_WIN32_THREADS 1)
set(ETHR_HAVE__INTERLOCKEDAND 1)
set(ETHR_HAVE__INTERLOCKEDAND64 1)
set(ETHR_HAVE__INTERLOCKEDCOMPAREEXCHANGE 1)
set(ETHR_HAVE__INTERLOCKEDCOMPAREEXCHANGE128 1)
set(ETHR_HAVE__INTERLOCKEDCOMPAREEXCHANGE64 1)
set(ETHR_HAVE__INTERLOCKEDDECREMENT 1)
set(ETHR_HAVE__INTERLOCKEDDECREMENT64 1)
set(ETHR_HAVE__INTERLOCKEDEXCHANGE 1)
set(ETHR_HAVE__INTERLOCKEDEXCHANGE64 1)
set(ETHR_HAVE__INTERLOCKEDEXCHANGEADD 1)
set(ETHR_HAVE__INTERLOCKEDEXCHANGEADD64 1)
set(ETHR_HAVE__INTERLOCKEDINCREMENT 1)
set(ETHR_HAVE__INTERLOCKEDINCREMENT64 1)
set(ETHR_HAVE__INTERLOCKEDOR 1)
set(ETHR_HAVE__INTERLOCKEDOR64 1)

set(HAVE_WINDOWS_H 1)
set(HAVE_WINSOCK2_H 1)
set(HAVE_WS2TCPIP_H 1)
set(HAVE_SDKDDKVER_H 1)
set(HAVE_STDIO_H 1)
set(HAVE_STDLIB_H 1)
set(HAVE_STRING_H 1)
set(HAVE_STRERROR 1)
set(HAVE_FCNTL_H 1)
set(HAVE_FSTAT 1)
set(HAVE_MALLOC_H 1)
set(HAVE_LIMITS_H 1)
set(HAVE_INTTYPES_H 1)
set(HAVE_STDINT_H 1)
set(HAVE_SYS_STAT_H 1)
set(HAVE_SYS_TYPES_H 1)
set(HAVE_GETADDRINFO 1)
set(HAVE_GETNAMEINFO 1)
set(HAVE_INET_PTON 1)
set(HAVE_IN6 1)
set(HAVE_IN6ADDR_ANY 1)
set(HAVE_IN6ADDR_LOOPBACK 1)
set(HAVE_IPV6 1)
set(HAVE_ISFINITE 1)
set(HAVE_SETLOCALE 1)
set(HAVE_STRFTIME 1)
set(HAVE_ZLIB_INFLATEGETDICTIONARY 1)
set(HAVE_CONFLICTING_FREAD_DECLARATION 1)
set(HAVE_COPYING_PUTENV 1)
set(DEF_INADDR_LOOPBACK_IN_WINSOCK2_H 1)
set(USE_SELECT 1)
set(NATIVE_ERLANG_STACK 1)
# The current Windows SDK already provides struct in6_addr. Do not define
# HAVE_IN_ADDR6_STRUCT. The target sets FD_SETSIZE=1024 before winsock is included.
set(NO_SA_LEN 1)

set(ERTS_EMU_CMDLINE_FLAGS
    " -D_WIN32_WINNT=0x0600 -DWINVER=0x0600 -DERTS_MIXED_VC -DUSE_THREADS -DWIN32_THREADS")

message(STATUS "Windows kernel poll: off; I/O: WaitForMultipleObjects; threads: Win32")
