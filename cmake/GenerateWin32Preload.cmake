# Script mode. Write beams.rc in the upstream make_preload -rc layout.
# Paths use forward slashes so rc.exe does not treat backslashes as escapes.
# The omitted w32_path.sh helper is not used.

if(NOT INPUT_LIST OR NOT OUTPUT)
    message(FATAL_ERROR "GenerateWin32Preload requires INPUT_LIST and OUTPUT")
endif()

file(STRINGS "${INPUT_LIST}" _beams)
if(NOT _beams)
    message(FATAL_ERROR "No preload beam files in ${INPUT_LIST}")
endif()

set(_code "")
set(_dict "")
set(_count 0)
foreach(_beam IN LISTS _beams)
    if(_beam STREQUAL "")
        continue()
    endif()
    if(NOT EXISTS "${_beam}")
        message(FATAL_ERROR "Missing preload beam: ${_beam}")
    endif()
    math(EXPR _count "${_count} + 1")
    file(SIZE "${_beam}" _size)
    get_filename_component(_module "${_beam}" NAME_WE)
    string(LENGTH "${_module}" _name_length)
    file(TO_CMAKE_PATH "${_beam}" _rc_path)
    string(APPEND _code "${_count} ERLANG_CODE \"${_rc_path}\"\n")
    string(APPEND _dict "    ${_size}L, ${_count}, ${_name_length},\"${_module}\",\n")
endforeach()

string(APPEND _body
"/*
 * Do *not* edit this file. It was automatically generated by
 * `GenerateWin32Preload.cmake'.
 */
${_code}#include <beam.rc>

0 ERLANG_DICT
BEGIN
    ${_count},
${_dict}END
")
file(WRITE "${OUTPUT}" "${_body}")
