cmake_minimum_required(VERSION 3.25)
# Verify an explicit seed inventory; this never refreshes tracked artifacts.
foreach(_required IN ITEMS MANIFEST SEEDS INVENTORY SOURCE_ROOT)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Compiler seed verification requires ${_required}")
    endif()
endforeach()
file(READ "${MANIFEST}" _manifest)
string(JSON _format GET "${_manifest}" format)
if(NOT _format EQUAL 1)
    message(FATAL_ERROR "Unsupported compiler seed manifest format")
endif()
string(JSON _option_count LENGTH "${_manifest}" options)
string(JSON _option GET "${_manifest}" options 0)
if(NOT _option_count EQUAL 1 OR NOT _option STREQUAL deterministic)
    message(FATAL_ERROR "Compiler seeds require the deterministic compilation recipe")
endif()
string(JSON _input_count LENGTH "${_manifest}" inputs)
if(_input_count LESS 1)
    message(FATAL_ERROR "Compiler source attestation is empty")
endif()
math(EXPR _input_last "${_input_count} - 1")
set(_inputs)
foreach(_index RANGE 0 ${_input_last})
    string(JSON _scope GET "${_manifest}" inputs ${_index} scope)
    string(JSON _path GET "${_manifest}" inputs ${_index} path)
    if(NOT _scope MATCHES "^(source|generated)$" OR IS_ABSOLUTE "${_path}" OR
       _path MATCHES "(^|/)\\.\\.(/|$)" OR "${_scope}:${_path}" IN_LIST _inputs)
        message(FATAL_ERROR "Invalid or duplicate compiler source input: ${_scope}:${_path}")
    endif()
    list(APPEND _inputs "${_scope}:${_path}")
endforeach()
file(STRINGS "${INVENTORY}" _expected)
string(JSON _count LENGTH "${_manifest}" modules)
set(_module_count "${_count}")
if(_count LESS 1)
    message(FATAL_ERROR "Compiler seed inventory is empty")
endif()
math(EXPR _last "${_count} - 1")
set(_modules)
foreach(_index RANGE 0 ${_last})
    string(JSON _name GET "${_manifest}" modules ${_index} name)
    string(JSON _hash GET "${_manifest}" modules ${_index} sha256)
    string(JSON _scope GET "${_manifest}" modules ${_index} source scope)
    string(JSON _path GET "${_manifest}" modules ${_index} source path)
    if(NOT "${_scope}:${_path}" IN_LIST _inputs)
        message(FATAL_ERROR "Compiler seed has no attested source: ${_name}")
    endif()
    if(NOT _name MATCHES "^[a-z][a-zA-Z0-9_]*$" OR _name IN_LIST _modules)
        message(FATAL_ERROR "Invalid or duplicate compiler seed module: ${_name}")
    endif()
    list(APPEND _modules "${_name}")
    file(SHA256 "${SEEDS}/${_name}.beam" _actual)
    if(NOT _actual STREQUAL _hash)
        message(FATAL_ERROR "Compiler seed hash mismatch: ${_name}")
    endif()
    if(DEFINED OUTPUTS)
        file(SHA256 "${OUTPUTS}/${_name}.beam" _output_hash)
        if(NOT _output_hash STREQUAL _hash)
            message(FATAL_ERROR "Compiler source does not reproduce ${_name}; generate and review seed candidates")
        endif()
    endif()
endforeach()
list(SORT _modules)
list(SORT _expected)
if(NOT _modules STREQUAL _expected)
    message(FATAL_ERROR "Compiler seed inventory differs from the declared compiler modules")
endif()
file(GLOB _seed_paths LIST_DIRECTORIES FALSE "${SEEDS}/*.beam")
set(_actual_modules)
foreach(_path IN LISTS _seed_paths)
    get_filename_component(_name "${_path}" NAME_WE)
    list(APPEND _actual_modules "${_name}")
endforeach()
list(SORT _actual_modules)
if(NOT _actual_modules STREQUAL _modules)
    message(FATAL_ERROR "Compiler seed directory contains missing or undeclared modules")
endif()
if(VERIFY_INPUTS)
    foreach(_index RANGE 0 ${_input_last})
        string(JSON _scope GET "${_manifest}" inputs ${_index} scope)
        string(JSON _path GET "${_manifest}" inputs ${_index} path)
        string(JSON _hash GET "${_manifest}" inputs ${_index} sha256)
        if(IS_ABSOLUTE "${_path}" OR _path MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Compiler input must remain within its declared root: ${_path}")
        endif()
        if(_scope STREQUAL source)
            set(_root "${SOURCE_ROOT}")
        elseif(_scope STREQUAL generated AND DEFINED GENERATED_ROOT)
            set(_root "${GENERATED_ROOT}")
        else()
            message(FATAL_ERROR "Unknown compiler input scope: ${_scope}")
        endif()
        file(SHA256 "${_root}/${_path}" _actual)
        if(NOT _actual STREQUAL _hash)
            message(FATAL_ERROR "Compiler source attestation mismatch: ${_path}; review seed regeneration")
        endif()
    endforeach()
endif()
message(STATUS "Verified ${_module_count} compiler seeds")
