# Native SDK producer copies: library compilation sees the public closure only.
foreach(_header IN ITEMS erl_nif erl_driver erl_drv_nif erl_nif_api_funcs )
    configure_file("${CMAKE_SOURCE_DIR}/src/erts/emulator/beam/${_header}.h"
        "${CMAKE_BINARY_DIR}/public-sdk/include/beam/nif/${_header}.h" COPYONLY)
endforeach()
if(WIN32)
    configure_file("${CMAKE_SOURCE_DIR}/src/erts/emulator/sys/win32/erl_win_dyn_driver.h"
        "${CMAKE_BINARY_DIR}/public-sdk/include/beam/nif/erl_win_dyn_driver.h" COPYONLY)
endif()
configure_file("${CMAKE_BINARY_DIR}/erts/include/erl_int_sizes_config.h"
    "${CMAKE_BINARY_DIR}/public-sdk/include/beam/nif/erl_int_sizes_config.h" COPYONLY)
configure_file("${CMAKE_SOURCE_DIR}/src/beam/native_support/beam_library_config.h.in"
    "${CMAKE_BINARY_DIR}/libraries/include/beam_library_config.h")
configure_file("${CMAKE_SOURCE_DIR}/include/beam/native.h"
    "${CMAKE_BINARY_DIR}/public-sdk/include/beam/native.h" COPYONLY)
# Passive library delivery. Both forms carry the same ordinary modules and
# typed resident tables; startup policy belongs to the host.
function(beam_add_library TARGET)
    cmake_parse_arguments(PARSE_ARGV 1 UNIT "TEST_ONLY" "NAME" "MODULES;BEAM_FILES;NIF_ENTRIES;NATIVE_SOURCES;DEPENDS")
    if(UNIT_UNPARSED_ARGUMENTS OR NOT UNIT_NAME)
        message(FATAL_ERROR "${TARGET}: provide library NAME")
    endif()
    list(LENGTH UNIT_MODULES _count)
    list(LENGTH UNIT_BEAM_FILES _file_count)
    list(LENGTH UNIT_NIF_ENTRIES _entry_count)
    if(NOT _count EQUAL _file_count OR NOT _count EQUAL _entry_count)
        message(FATAL_ERROR "${TARGET}: library inventories disagree")
    endif()
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    set(_dir "${CMAKE_BINARY_DIR}/libraries/${UNIT_NAME}")
    file(MAKE_DIRECTORY "${_dir}")
    set(_args --name "${UNIT_NAME}" --build-id "${BEAM_COMPONENT_BUILD_ID}")
    set(_wrappers "#include <erl_nif.h>\n")
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        list(GET UNIT_MODULES ${_index} _module)
        list(GET UNIT_BEAM_FILES ${_index} _bytes)
        list(GET UNIT_NIF_ENTRIES ${_index} _nif)
        list(APPEND _args --module "${_module}" "${_bytes}")
        if(NOT _nif STREQUAL "-")
            list(APPEND _args --nif "${_module}" "${_nif}_resident")
            string(APPEND _wrappers "extern ErlNifEntry *${_nif}(ERL_NIF_INIT_ARGS);\nErlNifEntry *${_nif}_resident(void) { return ${_nif}(\n#ifdef _WIN32\nNULL\n#endif\n); }\n")
        endif()
    endforeach()
    file(CONFIGURE OUTPUT "${_dir}/resident.c" CONTENT "${_wrappers}" @ONLY)
    set(_forms shared static)
    if(UNIT_TEST_ONLY)
        set(_forms shared)
    endif()
    foreach(_form IN LISTS _forms)
        set(_name "${TARGET}")
        set(_flag --shared)
        if(_form STREQUAL static)
            set(_name "${TARGET}_static")
            set(_flag)
        endif()
        string(SHA256 _unique "${BEAM_COMPONENT_BUILD_ID}:${UNIT_NAME}:${_form}")
        set(_accessor "beam_library_${_unique}")
        set(_descriptor "${_dir}/${_form}.c")
        add_custom_command(OUTPUT "${_descriptor}"
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/beam-library.py"
                ${_args} ${_flag} --accessor "${_accessor}" --output "${_descriptor}"
            DEPENDS ${UNIT_BEAM_FILES} ${UNIT_DEPENDS} "${CMAKE_SOURCE_DIR}/tools/beam-library.py"
            VERBATIM)
        string(TOUPPER "${_form}" _kind)
        add_library(${_name} ${_kind} ${UNIT_NATIVE_SOURCES} "${_descriptor}" "${_dir}/resident.c")
        target_compile_features(${_name} PRIVATE c_std_11)
        target_compile_definitions(${_name} PRIVATE ${BEAM_PLATFORM_DEFINITIONS} STATIC_ERLANG_DRIVER)
        target_include_directories(${_name} PRIVATE
            "${CMAKE_BINARY_DIR}/public-sdk/include" "${CMAKE_BINARY_DIR}/public-sdk/include/beam/nif"
            "${CMAKE_BINARY_DIR}/libraries/include" "${CMAKE_SOURCE_DIR}/src/beam/native_support")
        if(MSVC)
            target_compile_options(${_name} PRIVATE /experimental:c11atomics)
        endif()
        target_include_directories(${_name} PRIVATE "${CMAKE_SOURCE_DIR}/include")
        set_target_properties(${_name} PROPERTIES OUTPUT_NAME "beam-${UNIT_NAME}"
            POSITION_INDEPENDENT_CODE ON LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib"
            ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
        if(_form STREQUAL shared)
            string(SUBSTRING "${UNIT_NAME}" 0 1 _first)
            string(TOUPPER "${_first}" _first)
            string(SUBSTRING "${UNIT_NAME}" 1 -1 _rest)
            set_target_properties(${_name} PROPERTIES EXPORT_NAME "${_first}${_rest}")
            set(_counter beam_socket_count)
            if(UNIT_NAME MATCHES "^file")
                set(_counter beam_file_descriptor_count)
            elseif(UNIT_NAME STREQUAL zlib)
                set(_counter beam_zlib_stream_count)
            endif()
            if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR ANDROID)
                file(CONFIGURE OUTPUT "${_dir}/exports.map" CONTENT "{ global: beam_library_descriptor_v1; ${_counter}; local: *; };\n" @ONLY)
                target_link_options(${_name} PRIVATE "LINKER:-z,defs" "LINKER:--version-script,${_dir}/exports.map")
                set_property(TARGET ${_name} APPEND PROPERTY LINK_DEPENDS "${_dir}/exports.map")
            elseif(WIN32)
                file(CONFIGURE OUTPUT "${_dir}/exports.def" CONTENT "EXPORTS\n beam_library_descriptor_v1 DATA\n ${_counter}\n" @ONLY)
                target_sources(${_name} PRIVATE "${_dir}/exports.def")
                set_target_properties(${_name} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS OFF)
            elseif(APPLE)
                file(CONFIGURE OUTPUT "${_dir}/exports.macho" CONTENT "_beam_library_descriptor_v1\n_${_counter}\n" @ONLY)
                target_link_options(${_name} PRIVATE "LINKER:-exported_symbols_list,${_dir}/exports.macho")
            endif()
            target_link_libraries(${_name} PRIVATE libbeam)
            set_target_properties(${_name} PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "${BEAM_LOADER_ORIGIN}")
            beam_platform_library(${_name} "BEAM${UNIT_NAME}")
        else()
            # Keep library-specific compilation settings common to both forms.
            target_include_directories(${_name} PRIVATE "$<TARGET_PROPERTY:${TARGET},INCLUDE_DIRECTORIES>")
            target_compile_definitions(${_name} PRIVATE "$<TARGET_PROPERTY:${TARGET},COMPILE_DEFINITIONS>")
            target_compile_options(${_name} PRIVATE "$<TARGET_PROPERTY:${TARGET},COMPILE_OPTIONS>")
            string(SUBSTRING "${UNIT_NAME}" 0 1 _first)
            string(TOUPPER "${_first}" _first)
            string(SUBSTRING "${UNIT_NAME}" 1 -1 _rest)
            set_target_properties(${_name} PROPERTIES EXPORT_NAME "${_first}${_rest}Static")
            set(_header "${_dir}/${UNIT_NAME}.h")
            file(CONFIGURE OUTPUT "${_header}" CONTENT "#include <beam/library.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\nconst beam_library_descriptor *${_accessor}(void);\n#define beam_${UNIT_NAME}_library ${_accessor}\n#ifdef __cplusplus\n}\n#endif\n" @ONLY)
            install(FILES "${_header}" DESTINATION include/beam/libraries)
        endif()
    endforeach()
endfunction()
