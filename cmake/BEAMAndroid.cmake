# Native Gradle integration: Prefab owns the sole deployed shared runtime.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/BEAMRuntimeArtifacts.cmake")

# AGP 8.13 reads CMake file-api library fragments before unquoting them. A
# quoted absolute path is therefore omitted from its runtimeFiles inventory.
# Stage verified shared inputs inside the native build and link using relative
# imported locations. This keeps Gradle's one dependency graph authoritative,
# including when SDKs, exports or the project live in paths containing spaces.
function(_beam_android_stage_import target)
    get_target_property(_source "${target}" BEAM_ANDROID_ORIGINAL_LOCATION)
    if(NOT _source)
        get_target_property(_source "${target}" IMPORTED_LOCATION)
        if(NOT _source)
            get_target_property(_source "${target}" IMPORTED_LOCATION_RELEASE)
        endif()
        set_property(TARGET "${target}" PROPERTY BEAM_ANDROID_ORIGINAL_LOCATION "${_source}")
    endif()
    get_filename_component(_name "${_source}" NAME)
    file(SHA256 "${_source}" _digest)
    string(SHA256 _name_key "${_name}")
    get_property(_selected GLOBAL PROPERTY "BEAM_ANDROID_NATIVE_${_name_key}")
    if(_selected AND NOT _selected STREQUAL _digest)
        message(FATAL_ERROR "Conflicting Android native input: ${_name}")
    endif()
    set_property(GLOBAL PROPERTY "BEAM_ANDROID_NATIVE_${_name_key}" "${_digest}")
    set(_relative "beam-android-native/${_digest}/${_name}")
    set(_destination "${CMAKE_BINARY_DIR}/${_relative}")
    configure_file("${_source}" "${_destination}" COPYONLY)
    set_property(TARGET "${target}" PROPERTY IMPORTED_LOCATION "${_relative}")
    get_target_property(_configurations "${target}" IMPORTED_CONFIGURATIONS)
    if(NOT _configurations)
        set(_configurations)
    endif()
    foreach(_configuration IN LISTS _configurations)
        string(TOUPPER "${_configuration}" _configuration)
        set_property(TARGET "${target}" PROPERTY "IMPORTED_LOCATION_${_configuration}" "${_relative}")
    endforeach()
endfunction()

function(_beam_android_prefab component out)
    if(NOT ANDROID OR NOT BEAM_ANDROID_PREFAB)
        message(FATAL_ERROR "Android Prefab integration must be selected before find_package(BEAM)")
    endif()
    beam_get_runtime_artifact(_target NAME sdk.target)
    foreach(_pair IN ITEMS "android-abi|${ANDROID_ABI}" "baseline|${ANDROID_PLATFORM_LEVEL}" "ndk-version|28.2.13676358" "cxx-runtime|${ANDROID_STL}")
        string(REPLACE "|" ";" _parts "${_pair}")
        list(GET _parts 0 _key)
        list(GET _parts 1 _expected)
        file(STRINGS "${_target}" _entry REGEX "^${_key} = ")
        if(NOT _entry STREQUAL "${_key} = \"${_expected}\"")
            message(FATAL_ERROR "Android application ${_key} differs from selected SDK")
        endif()
    endforeach()
    file(STRINGS "${CMAKE_ANDROID_NDK}/source.properties" _revision REGEX "^Pkg.Revision")
    if(NOT _revision MATCHES "^Pkg.Revision[ =]+28\\.2\\.13676358 *$")
        message(FATAL_ERROR "Application must select Android NDK 28.2.13676358")
    endif()
    set(_package "beam_${component}")
    if(component STREQUAL "runtime")
        set(_module beam)
        set(_artifact runtime)
    else()
        set(_module "beam-${component}")
        set(_artifact "component.${component}")
    endif()
    # Do not change AGP's CMAKE_FIND_ROOT_PATH: it owns the generated Prefab roots.
    find_package(${_package} REQUIRED CONFIG)
    set(_native "${_package}::${_module}")
    if(NOT TARGET "${_native}")
        message(FATAL_ERROR "Missing Prefab target: ${_native}")
    endif()
    get_target_property(_location "${_native}" BEAM_ANDROID_ORIGINAL_LOCATION)
    if(NOT _location)
        get_target_property(_location "${_native}" IMPORTED_LOCATION)
    endif()
    if(NOT _location)
        get_target_property(_location "${_native}" IMPORTED_LOCATION_RELEASE)
    endif()
    if(NOT EXISTS "${_location}")
        message(FATAL_ERROR "Prefab target has no verified native library: ${_native}")
    endif()
    beam_get_runtime_artifact(_sdk_library NAME "${_artifact}")
    file(SHA256 "${_location}" _actual)
    file(SHA256 "${_sdk_library}" _expected)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Prefab native library differs from selected BEAM SDK: ${_native}")
    endif()
    get_filename_component(_directory "${_location}" DIRECTORY)
    file(READ "${_directory}/include/beam_android_provenance.json" _provenance)
    string(JSON _build GET "${_provenance}" target sdk-build-id)
    string(JSON _abi GET "${_provenance}" target android-abi)
    if(NOT _build STREQUAL BEAM_SDK_BUILD_ID OR NOT _abi STREQUAL ANDROID_ABI)
        message(FATAL_ERROR "Prefab provenance disagrees with selected SDK")
    endif()
    beam_get_runtime_artifact(_cxx NAME runtime.cxx)
    file(SHA256 "${_cxx}" _cxx_expected)
    file(SHA256 "${CMAKE_SYSROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/libc++_shared.so" _cxx_actual)
    if(NOT _cxx_actual STREQUAL _cxx_expected)
        message(FATAL_ERROR "Application NDK libc++_shared differs from selected SDK")
    endif()
    _beam_android_stage_import("${_native}")
    set(${out} "${_native}" PARENT_SCOPE)
endfunction()

function(_beam_android_runtime)
    if(TARGET BEAM::Runtime)
        message(FATAL_ERROR "A runtime was imported before the Android Prefab provider")
    endif()
    _beam_android_prefab(runtime _native)
    add_library(BEAM::Runtime INTERFACE IMPORTED)
    set_property(TARGET BEAM::Runtime PROPERTY INTERFACE_LINK_LIBRARIES "${_native}")
endfunction()

function(beam_target_android_application target)
    cmake_parse_arguments(PARSE_ARGV 1 APP "" "" "COMPONENTS;INVENTORIES")
    if(NOT TARGET "${target}" OR APP_UNPARSED_ARGUMENTS OR APP_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "beam_target_android_application requires a JNI target")
    endif()
    target_link_libraries("${target}" PRIVATE BEAM::Runtime android log)
    foreach(_component IN LISTS APP_COMPONENTS)
        if(NOT _component MATCHES "^(file|network|zlib)$")
            message(FATAL_ERROR "Unknown Android component: ${_component}")
        endif()
        _beam_android_prefab("${_component}" _native)
        target_link_libraries("${target}" PRIVATE "${_native}")
    endforeach()
    foreach(_native IN LISTS BEAM_PACKAGE_NATIVE_TARGETS)
        get_target_property(_kind "${_native}" TYPE)
        if(_kind STREQUAL "SHARED_LIBRARY")
            _beam_android_stage_import("${_native}")
        endif()
    endforeach()
    if(APP_INVENTORIES)
        beam_target_bytecode_verifier("${target}" INVENTORIES ${APP_INVENTORIES})
    endif()
    target_compile_definitions("${target}" PRIVATE "BEAM_ANDROID_ABI=\"${ANDROID_ABI}\"" "BEAM_ANDROID_FLAVOR=\"${BEAM_SDK_FLAVOR}\"")
endfunction()
