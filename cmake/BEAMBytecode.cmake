# Optional host-side verification. Runtime-only SDK discovery needs no ordinary
# module inventories and does not compile or acquire them implicitly.
include_guard(GLOBAL)

function(beam_check_bytecode_inventory inventory)
    if(NOT inventory MATCHES "^(base|boot|services)$")
        message(FATAL_ERROR "Unknown ordinary bytecode inventory: ${inventory}")
    endif()
    get_filename_component(_prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    string(TOUPPER "${inventory}" _upper)
    string(SUBSTRING "${inventory}" 0 1 _initial)
    string(TOUPPER "${_initial}" _initial)
    string(SUBSTRING "${inventory}" 1 -1 _rest)
    set(_expectations "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BEAM${_initial}${_rest}Inventory.cmake")
    if(NOT EXISTS "${_expectations}")
        message(FATAL_ERROR "Selected ${inventory} expectations are missing: ${_expectations}")
    endif()
    include("${_expectations}")
    if(NOT BEAM_${_upper}_EXPECTED_BUILD_ID STREQUAL BEAM_SDK_BUILD_ID)
        message(FATAL_ERROR "Selected ${inventory} expectations do not match this SDK build")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_expectations}")
    foreach(_record IN LISTS BEAM_${_upper}_EXPECTED_RECORDS)
        string(REPLACE "|" ";" _fields "${_record}")
        list(GET _fields 0 _relative)
        list(GET _fields 1 _size)
        list(GET _fields 2 _hash)
        set(_path "${_prefix}/${_relative}")
        if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
            message(FATAL_ERROR "Selected ${inventory} asset is missing: ${_path}")
        endif()
        file(SIZE "${_path}" _actual_size)
        file(SHA256 "${_path}" _actual_hash)
        if(NOT _actual_size EQUAL _size OR NOT _actual_hash STREQUAL _hash)
            message(FATAL_ERROR "Selected ${inventory} asset differs from its producer expectations: ${_path}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
    endforeach()
endfunction()

function(beam_target_bytecode_verifier target)
    cmake_parse_arguments(PARSE_ARGV 1 VERIFY "" "" "INVENTORIES")
    if(NOT TARGET "${target}" OR VERIFY_UNPARSED_ARGUMENTS OR
       VERIFY_KEYWORDS_MISSING_VALUES OR NOT VERIFY_INVENTORIES)
        message(FATAL_ERROR "beam_target_bytecode_verifier requires a target and INVENTORIES base, boot and/or services")
    endif()
    foreach(_inventory IN LISTS VERIFY_INVENTORIES)
        beam_check_bytecode_inventory("${_inventory}")
    endforeach()
    get_target_property(_added "${target}" BEAM_BYTECODE_VERIFIER_ADDED)
    if(NOT _added)
        get_filename_component(_prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
        target_sources("${target}" PRIVATE "${_prefix}/share/beam/sdk/beam_bytecode_verify.c")
        target_include_directories("${target}" PRIVATE "${_prefix}/include")
        target_compile_features("${target}" PRIVATE c_std_11)
        set_target_properties("${target}" PROPERTIES BEAM_BYTECODE_VERIFIER_ADDED TRUE)
    endif()
endfunction()
