cmake_minimum_required(VERSION 3.25)
# Installed-only SDK assembly. No source checkout, compiler or runtime is read.
include("${CMAKE_CURRENT_LIST_DIR}/SDKManifest.cmake")
if(NOT BEAM_SDK_INPUT_PREFIXES OR NOT BEAM_SDK_OUTPUT_PREFIX)
    message(FATAL_ERROR "AssembleSDK requires BEAM_SDK_INPUT_PREFIXES and BEAM_SDK_OUTPUT_PREFIX")
endif()
list(LENGTH BEAM_SDK_INPUT_PREFIXES _input_count)
if(_input_count GREATER 4)
    message(FATAL_ERROR "SDK assembly accepts one to four input prefixes")
endif()
if(IS_SYMLINK "${BEAM_SDK_OUTPUT_PREFIX}")
    message(FATAL_ERROR "SDK output prefix must not be a symlink")
endif()
beam_sdk_resolve_path("${BEAM_SDK_OUTPUT_PREFIX}" _output)
cmake_path(GET _output ROOT_PATH _output_root)
if(_output STREQUAL _output_root)
    message(FATAL_ERROR "SDK output prefix must not be a filesystem root")
endif()
if(EXISTS "${_output}")
    if(NOT IS_DIRECTORY "${_output}")
        message(FATAL_ERROR "SDK output prefix is not a directory")
    endif()
    file(GLOB _existing LIST_DIRECTORIES TRUE "${_output}/*" "${_output}/.*")
    if(_existing)
        message(FATAL_ERROR "SDK output prefix must be empty: ${_output}")
    endif()
endif()

function(_beam_remap_common manifest path output)
    string(JSON _version GET "${manifest}" erts_version)
    foreach(_field preload_resource_dir preload_source_dir preload_ebin_dir include_dir)
        string(JSON _old GET "${manifest}" ${_field})
        set(_base "${_old}")
        cmake_path(IS_PREFIX _base "${path}" NORMALIZE _inside)
        if(_inside)
            if(_field STREQUAL "include_dir")
                set(_new include)
            elseif(_field STREQUAL "preload_resource_dir")
                set(_new "share/beam/erts-${_version}/resources")
            elseif(_field STREQUAL "preload_source_dir")
                set(_new "share/beam/erts-${_version}/src")
            else()
                set(_new "share/beam/erts-${_version}/ebin")
            endif()
            file(RELATIVE_PATH _rest "/${_old}" "/${path}")
            set(${output} "${_new}/${_rest}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Unrecognized common SDK asset: ${path}")
endfunction()

# Validate every input before writing output. Cross-prefix comparisons use
# canonical destination paths, allowing relative GNUInstallDirs customizations.
set(_variant_keys "")
set(_variants "[]")
set(_variant_index 0)
set(_reference_common "")
set(_prefixes "")
foreach(_input IN LISTS BEAM_SDK_INPUT_PREFIXES)
    beam_sdk_resolve_path("${_input}" _prefix)
    set(_compare_prefix "${_prefix}")
    set(_compare_output "${_output}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${_compare_prefix}" _compare_prefix)
        string(TOLOWER "${_compare_output}" _compare_output)
    endif()
    cmake_path(IS_PREFIX _compare_prefix "${_compare_output}" NORMALIZE _output_inside)
    cmake_path(IS_PREFIX _compare_output "${_compare_prefix}" NORMALIZE _input_inside)
    if(_output_inside OR _input_inside)
        message(FATAL_ERROR "SDK input/output prefixes overlap: ${_prefix}")
    endif()
    if(NOT EXISTS "${_prefix}/manifest.json")
        message(FATAL_ERROR "Missing installed SDK manifest: ${_prefix}/manifest.json")
    endif()
    file(READ "${_prefix}/manifest.json" _manifest)
    string(JSON _schema GET "${_manifest}" schema)
    if(NOT _schema EQUAL 1)
        message(FATAL_ERROR "Unsupported SDK manifest schema: ${_prefix}")
    endif()
    if(NOT DEFINED _reference)
        set(_reference "${_manifest}")
        set(_reference_prefix "${_prefix}")
    else()
        foreach(_field version erts_version upstream_commit source_id system_name architecture host_triple
                deployment_target dynamic_trace toolchain_id msvc_runtime_family)
            string(JSON _expected GET "${_reference}" ${_field})
            string(JSON _actual GET "${_manifest}" ${_field})
            if(NOT _expected STREQUAL _actual)
                message(FATAL_ERROR "Incompatible SDK ${_field}: ${_prefix}")
            endif()
        endforeach()
    endif()
    string(JSON _package_count LENGTH "${_manifest}" package_files)
    if(NOT _package_count EQUAL 5)
        message(FATAL_ERROR "SDK package inventory is incomplete: ${_prefix}")
    endif()
    string(JSON _package_dir GET "${_manifest}" package_dir)
    set(_required_package_paths "")
    foreach(_file BEAMConfig.cmake BEAMConfigVersion.cmake BEAMInstall.cmake AssembleSDK.cmake SDKManifest.cmake)
        list(APPEND _required_package_paths "${_package_dir}/${_file}")
    endforeach()
    set(_actual_package_paths "")
    math(EXPR _package_last "${_package_count} - 1")
    foreach(_index RANGE 0 ${_package_last})
        string(JSON _record GET "${_manifest}" package_files ${_index})
        beam_sdk_validate_record("${_prefix}" "${_record}")
        string(JSON _path GET "${_record}" path)
        list(APPEND _actual_package_paths "${_path}")
    endforeach()
    list(SORT _required_package_paths)
    list(SORT _actual_package_paths)
    if(NOT _required_package_paths STREQUAL _actual_package_paths)
        message(FATAL_ERROR "SDK package inventory is incomplete or duplicated: ${_prefix}")
    endif()
    string(JSON _common_count LENGTH "${_manifest}" common_files)
    if(_common_count LESS 1)
        message(FATAL_ERROR "SDK has no common assets: ${_prefix}")
    endif()
    math(EXPR _common_last "${_common_count} - 1")
    set(_common_keys "")
    foreach(_index RANGE 0 ${_common_last})
        string(JSON _record GET "${_manifest}" common_files ${_index})
        beam_sdk_validate_record("${_prefix}" "${_record}")
        string(JSON _alias ERROR_VARIABLE _alias_error GET "${_record}" symlink)
        if(NOT _alias_error)
            message(FATAL_ERROR "Common SDK assets must be regular files before remapping: ${_prefix}")
        endif()
        string(JSON _path GET "${_record}" path)
        _beam_remap_common("${_manifest}" "${_path}" _mapped)
        beam_sdk_json_quote(_quoted "${_mapped}")
        string(JSON _record SET "${_record}" path "${_quoted}")
        string(SHA256 _key "${_mapped}")
        if(DEFINED _common_record_${_key})
            message(FATAL_ERROR "Duplicate common SDK asset: ${_mapped}")
        endif()
        set(_common_record_${_key} "${_record}")
        list(APPEND _common_keys "${_mapped}|${_key}")
    endforeach()
    list(SORT _common_keys)
    set(_common "[]")
    set(_index 0)
    foreach(_entry IN LISTS _common_keys)
        string(REGEX REPLACE "^.*[|]" "" _key "${_entry}")
        string(JSON _common SET "${_common}" ${_index} "${_common_record_${_key}}")
        unset(_common_record_${_key})
        math(EXPR _index "${_index} + 1")
    endforeach()
    if(_reference_common STREQUAL "")
        set(_reference_common "${_common}")
    elseif(NOT _reference_common STREQUAL _common)
        message(FATAL_ERROR "Unequal common SDK assets: ${_prefix}")
    endif()
    string(JSON _count LENGTH "${_manifest}" variants)
    if(_count LESS 1)
        message(FATAL_ERROR "SDK has no runtime configurations: ${_prefix}")
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _variant GET "${_manifest}" variants ${_index})
        string(JSON _flavor GET "${_variant}" flavor)
        string(JSON _type GET "${_variant}" build_type)
        if(NOT _flavor MATCHES "^(emu|jit)$" OR NOT _type MATCHES "^(Release|Debug)$")
            message(FATAL_ERROR "Unsupported SDK runtime configuration: ${_flavor}/${_type}")
        endif()
        set(_key "${_flavor}/${_type}")
        if(_key IN_LIST _variant_keys)
            message(FATAL_ERROR "Duplicate SDK runtime configuration: ${_key}")
        endif()
        list(APPEND _variant_keys "${_key}")
        string(JSON _file_count LENGTH "${_variant}" files)
        if(_file_count LESS 1)
            message(FATAL_ERROR "SDK runtime configuration has no artifacts: ${_key}")
        endif()
        math(EXPR _file_last "${_file_count} - 1")
        set(_record_paths "")
        foreach(_file_index RANGE 0 ${_file_last})
            string(JSON _record GET "${_variant}" files ${_file_index})
            beam_sdk_validate_record("${_prefix}" "${_record}")
            string(JSON _path GET "${_record}" path)
            list(APPEND _record_paths "${_path}")
        endforeach()
        string(JSON _variant_system GET "${_manifest}" system_name)
        foreach(_field archive executable child_setup pdb)
            string(JSON _path GET "${_variant}" ${_field})
            if((_field STREQUAL "archive" OR _field STREQUAL "executable"
                    OR (_field STREQUAL "child_setup" AND NOT _variant_system STREQUAL "Windows")
                    OR (_field STREQUAL "pdb" AND _variant_system STREQUAL "Windows" AND _type STREQUAL "Debug"))
                    AND _path STREQUAL "")
                message(FATAL_ERROR "Missing SDK ${_field}: ${_key}")
            endif()
            if(_field STREQUAL "child_setup" AND _variant_system STREQUAL "Windows" AND NOT _path STREQUAL "")
                message(FATAL_ERROR "Windows SDK must not contain a child helper: ${_key}")
            endif()
            if(NOT _path STREQUAL "" AND NOT _path IN_LIST _record_paths)
                message(FATAL_ERROR "SDK ${_field} is absent from artifact inventory: ${_key}")
            endif()
        endforeach()
        string(JSON _variants SET "${_variants}" ${_variant_index} "${_variant}")
        set(_variant_prefix_${_variant_index} "${_prefix}")
        math(EXPR _variant_index "${_variant_index} + 1")
    endforeach()
endforeach()
if(_variant_index GREATER 4)
    message(FATAL_ERROR "SDK assembly supports at most four distinct runtime configurations")
endif()
string(JSON _reference_package GET "${_reference}" package_dir)
set(_package_files BEAMConfig.cmake BEAMConfigVersion.cmake BEAMInstall.cmake AssembleSDK.cmake SDKManifest.cmake)
foreach(_file IN LISTS _package_files)
    beam_sdk_asset_path("${_reference_prefix}" "${_reference_package}/${_file}" _package_file)
endforeach()

file(MAKE_DIRECTORY "${_output}/lib/cmake/BEAM")
# Copy common assets only after validating their entire inventories.
string(JSON _common_count LENGTH "${_reference}" common_files)
math(EXPR _common_last "${_common_count} - 1")
set(_common_paths "")
foreach(_index RANGE 0 ${_common_last})
    string(JSON _path GET "${_reference}" common_files ${_index} path)
    _beam_remap_common("${_reference}" "${_path}" _mapped)
    get_filename_component(_directory "${_mapped}" DIRECTORY)
    file(MAKE_DIRECTORY "${_output}/${_directory}")
    file(COPY "${_reference_prefix}/${_path}" DESTINATION "${_output}/${_directory}" USE_SOURCE_PERMISSIONS)
    list(APPEND _common_paths "${_mapped}")
endforeach()
foreach(_file IN LISTS _package_files)
    file(COPY_FILE "${_reference_prefix}/${_reference_package}/${_file}" "${_output}/lib/cmake/BEAM/${_file}")
endforeach()

set(_result "${_reference}")
foreach(_pair "include_dir|include" "native_include_dir|include/beam/erts"
        "preload_ebin_dir|share/beam/erts-" "preload_source_dir|share/beam/erts-"
        "preload_resource_dir|share/beam/erts-" "package_dir|lib/cmake/BEAM")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _field)
    list(GET _pair 1 _path)
    if(_field MATCHES "^preload_")
        string(JSON _version GET "${_result}" erts_version)
        string(APPEND _path "${_version}")
        if(_field STREQUAL "preload_ebin_dir")
            string(APPEND _path /ebin)
        elseif(_field STREQUAL "preload_source_dir")
            string(APPEND _path /src)
        else()
            string(APPEND _path /resources)
        endif()
    endif()
    beam_sdk_json_quote(_quoted "${_path}")
    string(JSON _result SET "${_result}" ${_field} "${_quoted}")
endforeach()
set(_package_paths "")
foreach(_file IN LISTS _package_files)
    list(APPEND _package_paths "lib/cmake/BEAM/${_file}")
endforeach()
beam_sdk_json_array(_array ${_package_paths})
string(JSON _result SET "${_result}" package_files "${_array}")
list(SORT _common_paths)
beam_sdk_json_array(_array ${_common_paths})
string(JSON _result SET "${_result}" common_files "${_array}")
string(JSON _system GET "${_result}" system_name)
math(EXPR _last "${_variant_index} - 1")
set(_result_variants "[]")
foreach(_index RANGE 0 ${_last})
    string(JSON _variant GET "${_variants}" ${_index})
    string(JSON _flavor GET "${_variant}" flavor)
    string(JSON _type GET "${_variant}" build_type)
    set(_name beam)
    if(_flavor STREQUAL "jit")
        string(APPEND _name _jit)
    endif()
    if(_type STREQUAL "Debug")
        string(APPEND _name _debug)
    endif()
    if(_system STREQUAL "Windows")
        set(_archive "lib/${_name}.lib")
        set(_executable "bin/${_name}.exe")
    else()
        set(_archive "lib/lib${_name}.a")
        set(_executable "bin/${_name}")
    endif()
    set(_files "")
    foreach(_field archive executable child_setup pdb)
        string(JSON _old GET "${_variant}" ${_field})
        if(_field STREQUAL "archive")
            set(_new "${_archive}")
        elseif(_field STREQUAL "executable")
            set(_new "${_executable}")
        elseif(_field STREQUAL "child_setup" AND NOT _old STREQUAL "")
            set(_new "libexec/beam/${_flavor}/${_type}/erl_child_setup")
        elseif(_field STREQUAL "pdb" AND NOT _old STREQUAL "")
            set(_new "bin/${_name}.pdb")
        else()
            set(_new "")
        endif()
        if(NOT _new STREQUAL "")
            get_filename_component(_directory "${_new}" DIRECTORY)
            file(MAKE_DIRECTORY "${_output}/${_directory}")
            file(COPY_FILE "${_variant_prefix_${_index}}/${_old}" "${_output}/${_new}")
            if(_field STREQUAL "executable" OR _field STREQUAL "child_setup")
                file(CHMOD "${_output}/${_new}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
            endif()
            list(APPEND _files "${_new}")
            if(_field STREQUAL "child_setup" AND _type STREQUAL "Debug")
                file(CREATE_LINK erl_child_setup "${_output}/${_directory}/erl_child_setup.debug" SYMBOLIC)
                list(APPEND _files "${_directory}/erl_child_setup.debug")
            endif()
        endif()
        beam_sdk_json_quote(_quoted "${_new}")
        string(JSON _variant SET "${_variant}" ${_field} "${_quoted}")
    endforeach()
    beam_sdk_json_array(_array ${_files})
    string(JSON _variant SET "${_variant}" files "${_array}")
    string(JSON _result_variants SET "${_result_variants}" ${_index} "${_variant}")
endforeach()
string(JSON _result SET "${_result}" variants "${_result_variants}")
beam_sdk_finalize_manifest("${_output}" "${_result}" _result)
file(WRITE "${_output}/manifest.json" "${_result}\n")
message(STATUS "Assembled BEAM SDK (${_variant_keys}): ${_output}")
