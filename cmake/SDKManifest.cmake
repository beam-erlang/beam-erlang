# Installed SDK data helpers. Paths in manifests are relative to their prefix.
include_guard(GLOBAL)

function(beam_sdk_json_quote output value)
    string(REPLACE "\\" "\\\\" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    set(${output} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(beam_sdk_json_array output)
    set(_array "[]")
    set(_index 0)
    foreach(_item IN LISTS ARGN)
        beam_sdk_json_quote(_quoted "${_item}")
        string(JSON _array SET "${_array}" ${_index} "${_quoted}")
        math(EXPR _index "${_index} + 1")
    endforeach()
    set(${output} "${_array}" PARENT_SCOPE)
endfunction()

function(beam_sdk_resolve_path input output)
    get_filename_component(_absolute "${input}" ABSOLUTE)
    cmake_path(NORMAL_PATH _absolute)
    set(_parent "${_absolute}")
    set(_tail "")
    while(NOT EXISTS "${_parent}")
        get_filename_component(_name "${_parent}" NAME)
        get_filename_component(_next "${_parent}" DIRECTORY)
        if(_next STREQUAL _parent)
            message(FATAL_ERROR "Cannot resolve SDK path: ${input}")
        endif()
        set(_tail "${_name}/${_tail}")
        set(_parent "${_next}")
    endwhile()
    file(REAL_PATH "${_parent}" _parent)
    set(_absolute "${_parent}/${_tail}")
    cmake_path(NORMAL_PATH _absolute)
    cmake_path(GET _absolute ROOT_PATH _root)
    if(NOT _absolute STREQUAL _root)
        string(REGEX REPLACE "/$" "" _absolute "${_absolute}")
    endif()
    set(${output} "${_absolute}" PARENT_SCOPE)
endfunction()

function(beam_sdk_asset_path prefix relative output)
    if("${relative}" STREQUAL "" OR IS_ABSOLUTE "${relative}" OR "${relative}" MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid relative SDK asset path: ${relative}")
    endif()
    set(_path "${prefix}/${relative}")
    cmake_path(NORMAL_PATH _path)
    cmake_path(IS_PREFIX prefix "${_path}" NORMALIZE _inside)
    if(NOT _inside OR NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
        message(FATAL_ERROR "Missing SDK asset: ${relative}")
    endif()
    file(REAL_PATH "${_path}" _resolved)
    cmake_path(IS_PREFIX prefix "${_resolved}" NORMALIZE _inside)
    if(NOT _inside)
        message(FATAL_ERROR "SDK asset escapes its prefix: ${relative}")
    endif()
    set(${output} "${_path}" PARENT_SCOPE)
endfunction()

function(beam_sdk_directory_path prefix relative output)
    if("${relative}" STREQUAL "" OR IS_ABSOLUTE "${relative}" OR "${relative}" MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid relative SDK directory: ${relative}")
    endif()
    set(_path "${prefix}/${relative}")
    cmake_path(NORMAL_PATH _path)
    cmake_path(IS_PREFIX prefix "${_path}" NORMALIZE _inside)
    if(NOT _inside OR NOT IS_DIRECTORY "${_path}")
        message(FATAL_ERROR "Missing SDK directory: ${relative}")
    endif()
    file(REAL_PATH "${_path}" _resolved)
    cmake_path(IS_PREFIX prefix "${_resolved}" NORMALIZE _inside)
    if(NOT _inside)
        message(FATAL_ERROR "SDK directory escapes its prefix: ${relative}")
    endif()
    set(${output} "${_path}" PARENT_SCOPE)
endfunction()

function(beam_sdk_file_record prefix relative output)
    beam_sdk_asset_path("${prefix}" "${relative}" _path)
    file(SHA256 "${_path}" _hash)
    beam_sdk_json_quote(_quoted_path "${relative}")
    beam_sdk_json_quote(_quoted_hash "${_hash}")
    set(_record "{}")
    string(JSON _record SET "${_record}" path "${_quoted_path}")
    string(JSON _record SET "${_record}" sha256 "${_quoted_hash}")
    if(IS_SYMLINK "${_path}")
        file(READ_SYMLINK "${_path}" _target)
        if(IS_ABSOLUTE "${_target}")
            message(FATAL_ERROR "SDK alias must be relative: ${relative}")
        endif()
        beam_sdk_json_quote(_quoted_target "${_target}")
        string(JSON _record SET "${_record}" symlink "${_quoted_target}")
    endif()
    set(${output} "${_record}" PARENT_SCOPE)
endfunction()

function(beam_sdk_validate_record prefix record)
    string(JSON _relative GET "${record}" path)
    beam_sdk_file_record("${prefix}" "${_relative}" _actual)
    if(NOT _actual STREQUAL record)
        message(FATAL_ERROR "Changed SDK asset: ${_relative}")
    endif()
endfunction()

# Fill path arrays with hash records after installation/copying has completed.
function(beam_sdk_finalize_manifest prefix manifest output)
    foreach(_group common_files package_files)
        string(JSON _count LENGTH "${manifest}" ${_group})
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_index RANGE 0 ${_last})
                string(JSON _relative GET "${manifest}" ${_group} ${_index})
                beam_sdk_file_record("${prefix}" "${_relative}" _record)
                string(JSON manifest SET "${manifest}" ${_group} ${_index} "${_record}")
            endforeach()
        endif()
    endforeach()
    string(JSON _count LENGTH "${manifest}" variants)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _file_count LENGTH "${manifest}" variants ${_index} files)
        math(EXPR _file_last "${_file_count} - 1")
        foreach(_file_index RANGE 0 ${_file_last})
            string(JSON _relative GET "${manifest}" variants ${_index} files ${_file_index})
            beam_sdk_file_record("${prefix}" "${_relative}" _record)
            string(JSON manifest SET "${manifest}" variants ${_index} files ${_file_index} "${_record}")
        endforeach()
    endforeach()
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()
