@PACKAGE_INIT@

# A single selector serves individual installations and assembled SDKs.
set(_beam_prefix "${CMAKE_CURRENT_LIST_DIR}")
while(NOT EXISTS "${_beam_prefix}/manifest.json")
    get_filename_component(_beam_parent "${_beam_prefix}" DIRECTORY)
    if(_beam_parent STREQUAL _beam_prefix)
        set(BEAM_FOUND FALSE)
        set(BEAM_NOT_FOUND_MESSAGE "Missing installed BEAM SDK manifest")
        return()
    endif()
    set(_beam_prefix "${_beam_parent}")
endwhile()
file(REAL_PATH "${_beam_prefix}" _beam_prefix)
file(READ "${_beam_prefix}/manifest.json" _beam_manifest)
string(JSON _beam_schema GET "${_beam_manifest}" schema)
if(NOT _beam_schema EQUAL 1)
    set(BEAM_FOUND FALSE)
    set(BEAM_NOT_FOUND_MESSAGE "Unsupported BEAM SDK manifest schema")
    return()
endif()
macro(_beam_reject message_text)
    set(BEAM_FOUND FALSE)
    set(BEAM_NOT_FOUND_MESSAGE "${message_text}")
    return()
endmacro()
include("${CMAKE_CURRENT_LIST_DIR}/SDKManifest.cmake")
string(JSON _beam_relative GET "${_beam_manifest}" package_dir)
beam_sdk_directory_path("${_beam_prefix}" "${_beam_relative}" _beam_package_directory)
file(REAL_PATH "${_beam_package_directory}" _beam_package_directory)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}" _beam_current_package_directory)
if(NOT _beam_package_directory STREQUAL _beam_current_package_directory)
    _beam_reject("Missing installed BEAM SDK manifest for this package directory")
endif()
if(CMAKE_CONFIGURATION_TYPES)
    _beam_reject("BEAM SDK supports single-config Release or Debug consumers")
endif()
if(NOT DEFINED BEAM_RUNTIME_FLAVOR)
    set(BEAM_RUNTIME_FLAVOR emu)
endif()
if(NOT BEAM_RUNTIME_FLAVOR MATCHES "^(emu|jit)$")
    _beam_reject("Unsupported BEAM runtime flavor: ${BEAM_RUNTIME_FLAVOR}")
endif()
set(_beam_configuration "${CMAKE_BUILD_TYPE}")
if(_beam_configuration STREQUAL "")
    set(_beam_configuration Release)
elseif(NOT _beam_configuration MATCHES "^(Release|Debug)$")
    _beam_reject("Unsupported BEAM SDK build type: ${_beam_configuration}")
endif()
foreach(_beam_field version erts_version upstream_commit source_id system_name architecture host_triple deployment_target dynamic_trace toolchain_id)
    string(TOUPPER "${_beam_field}" _beam_upper)
    string(JSON BEAM_SDK_${_beam_upper} GET "${_beam_manifest}" ${_beam_field})
endforeach()
set(BEAM_SDK_AVAILABLE_VARIANTS "")
set(_beam_selected "")
string(JSON _beam_count LENGTH "${_beam_manifest}" variants)
math(EXPR _beam_last "${_beam_count} - 1")
foreach(_beam_index RANGE 0 ${_beam_last})
    string(JSON _beam_variant GET "${_beam_manifest}" variants ${_beam_index})
    string(JSON _beam_flavor GET "${_beam_variant}" flavor)
    string(JSON _beam_type GET "${_beam_variant}" build_type)
    list(APPEND BEAM_SDK_AVAILABLE_VARIANTS "${_beam_flavor}/${_beam_type}")
    if(_beam_flavor STREQUAL BEAM_RUNTIME_FLAVOR AND _beam_type STREQUAL _beam_configuration)
        set(_beam_selected "${_beam_variant}")
    endif()
endforeach()
if(_beam_selected STREQUAL "")
    _beam_reject("SDK build type/flavor ${BEAM_RUNTIME_FLAVOR}/${_beam_configuration} is unavailable; available: ${BEAM_SDK_AVAILABLE_VARIANTS}")
endif()
set(BEAM_SDK_FLAVOR "${BEAM_RUNTIME_FLAVOR}")
set(BEAM_SDK_BUILD_TYPE "${_beam_configuration}")
foreach(_beam_field build_id msvc_runtime_library)
    string(TOUPPER "${_beam_field}" _beam_upper)
    string(JSON BEAM_SDK_${_beam_upper} GET "${_beam_selected}" ${_beam_field})
endforeach()
if(NOT CMAKE_SYSTEM_NAME STREQUAL BEAM_SDK_SYSTEM_NAME)
    _beam_reject("SDK targets ${BEAM_SDK_SYSTEM_NAME}; consumer targets ${CMAKE_SYSTEM_NAME}")
endif()
if((BEAM_SDK_ARCHITECTURE STREQUAL "arm" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
        OR (BEAM_SDK_ARCHITECTURE STREQUAL "x86" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
    _beam_reject("SDK architecture ${BEAM_SDK_ARCHITECTURE} does not match ${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(BEAM_SDK_SYSTEM_NAME STREQUAL "Darwin")
    if(CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
        _beam_reject("BEAM SDK requires a single arm64 consumer architecture")
    endif()
    if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS BEAM_SDK_DEPLOYMENT_TARGET)
        _beam_reject("SDK requires macOS ${BEAM_SDK_DEPLOYMENT_TARGET} or newer")
    endif()
endif()
if(BEAM_SDK_SYSTEM_NAME STREQUAL "Windows")
    if(NOT MSVC)
        _beam_reject("BEAM SDK requires an MSVC consumer")
    endif()
    set(_beam_debug_suffix "")
    if(_beam_configuration STREQUAL "Debug")
        set(_beam_debug_suffix Debug)
    endif()
    set(_beam_crt "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    if(_beam_crt STREQUAL "")
        set(_beam_crt "MultiThreaded${_beam_debug_suffix}DLL")
    else()
        string(REPLACE "$<$<CONFIG:Debug>:Debug>" "${_beam_debug_suffix}" _beam_crt "${_beam_crt}")
    endif()
    if(NOT _beam_crt STREQUAL BEAM_SDK_MSVC_RUNTIME_LIBRARY)
        _beam_reject("SDK MSVC runtime ${BEAM_SDK_MSVC_RUNTIME_LIBRARY} does not match ${_beam_crt}")
    endif()
    enable_language(RC)
else()
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
endif()
set(_beam_selection "${_beam_prefix}|${BEAM_SDK_FLAVOR}|${BEAM_SDK_BUILD_TYPE}|${BEAM_SDK_BUILD_ID}")
if(TARGET BEAM::Runtime)
    get_target_property(_beam_previous BEAM::Runtime BEAM_SDK_SELECTION)
    if(NOT _beam_previous STREQUAL _beam_selection)
        _beam_reject("Conflicting BEAM SDK or flavor selection in this consumer build")
    endif()
endif()
foreach(_beam_field include_dir native_include_dir preload_ebin_dir preload_source_dir)
    string(TOUPPER "${_beam_field}" _beam_upper)
    string(JSON _beam_relative GET "${_beam_manifest}" ${_beam_field})
    beam_sdk_directory_path("${_beam_prefix}" "${_beam_relative}" BEAM_SDK_${_beam_upper})
endforeach()
string(JSON _beam_archive GET "${_beam_selected}" archive)
beam_sdk_asset_path("${_beam_prefix}" "${_beam_archive}" BEAM_SDK_ARCHIVE)
string(JSON _beam_executable GET "${_beam_selected}" executable)
beam_sdk_asset_path("${_beam_prefix}" "${_beam_executable}" BEAM_SDK_EXECUTABLE)
if(NOT TARGET BEAM::Runtime)
    add_library(BEAM::_RuntimeArchive STATIC IMPORTED GLOBAL)
    set(_beam_configs "")
    foreach(_beam_index RANGE 0 ${_beam_last})
        string(JSON _beam_variant GET "${_beam_manifest}" variants ${_beam_index})
        string(JSON _beam_flavor GET "${_beam_variant}" flavor)
        if(_beam_flavor STREQUAL BEAM_SDK_FLAVOR)
            string(JSON _beam_type GET "${_beam_variant}" build_type)
            string(TOUPPER "${_beam_type}" _beam_upper)
            string(JSON _beam_archive GET "${_beam_variant}" archive)
            string(JSON _beam_language GET "${_beam_variant}" link_language)
            list(APPEND _beam_configs "${_beam_upper}")
            beam_sdk_asset_path("${_beam_prefix}" "${_beam_archive}" _beam_archive_path)
            set_target_properties(BEAM::_RuntimeArchive PROPERTIES
                IMPORTED_LOCATION_${_beam_upper} "${_beam_archive_path}"
                IMPORTED_LINK_INTERFACE_LANGUAGES_${_beam_upper} "${_beam_language}"
                MAP_IMPORTED_CONFIG_${_beam_upper} "${_beam_upper}")
        endif()
    endforeach()
    set_target_properties(BEAM::_RuntimeArchive PROPERTIES
        IMPORTED_CONFIGURATIONS "${_beam_configs}" IMPORTED_LOCATION "${BEAM_SDK_ARCHIVE}")
    string(JSON _beam_language GET "${_beam_selected}" link_language)
    set_property(TARGET BEAM::_RuntimeArchive PROPERTY IMPORTED_LINK_INTERFACE_LANGUAGES "${_beam_language}")
    add_library(BEAM::Runtime INTERFACE IMPORTED GLOBAL)
    set_target_properties(BEAM::Runtime PROPERTIES
        BEAM_SDK_SELECTION "${_beam_selection}"
        INTERFACE_INCLUDE_DIRECTORIES "${BEAM_SDK_INCLUDE_DIR}")
    set(_beam_links "$<LINK_LIBRARY:WHOLE_ARCHIVE,BEAM::_RuntimeArchive>")
    string(JSON _beam_length LENGTH "${_beam_selected}" link_libraries)
    if(_beam_length GREATER 0)
        math(EXPR _beam_link_last "${_beam_length} - 1")
        foreach(_beam_link_index RANGE 0 ${_beam_link_last})
            string(JSON _beam_link GET "${_beam_selected}" link_libraries ${_beam_link_index})
            list(APPEND _beam_links "${_beam_link}")
        endforeach()
    endif()
    set_property(TARGET BEAM::Runtime PROPERTY INTERFACE_LINK_LIBRARIES "${_beam_links}")
    string(JSON _beam_length LENGTH "${_beam_selected}" link_options)
    set(_beam_options "")
    if(_beam_length GREATER 0)
        math(EXPR _beam_link_last "${_beam_length} - 1")
        foreach(_beam_link_index RANGE 0 ${_beam_link_last})
            string(JSON _beam_link GET "${_beam_selected}" link_options ${_beam_link_index})
            list(APPEND _beam_options "${_beam_link}")
        endforeach()
    endif()
    set_property(TARGET BEAM::Runtime PROPERTY INTERFACE_LINK_OPTIONS "${_beam_options}")
    foreach(_beam_kind NIF Driver)
        add_library(BEAM::${_beam_kind} INTERFACE IMPORTED GLOBAL)
        set_property(TARGET BEAM::${_beam_kind} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${BEAM_SDK_NATIVE_INCLUDE_DIR}")
        if(BEAM_SDK_SYSTEM_NAME STREQUAL "Darwin")
            set_property(TARGET BEAM::${_beam_kind} PROPERTY INTERFACE_LINK_OPTIONS "LINKER:-undefined,dynamic_lookup")
        endif()
    endforeach()
endif()
if(BEAM_SDK_SYSTEM_NAME STREQUAL "Windows")
    string(JSON _beam_relative GET "${_beam_manifest}" preload_resource_dir)
    beam_sdk_directory_path("${_beam_prefix}" "${_beam_relative}" BEAM_SDK_PRELOAD_RESOURCE_DIR)
    set_property(TARGET BEAM::Runtime PROPERTY INTERFACE_SOURCES "${BEAM_SDK_PRELOAD_RESOURCE_DIR}/beams.rc")
    set_property(TARGET BEAM::Runtime APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
        "$<$<COMPILE_LANGUAGE:RC>:${BEAM_SDK_PRELOAD_RESOURCE_DIR}>")
    file(GLOB _beam_seeds "${BEAM_SDK_PRELOAD_RESOURCE_DIR}/ebin/*.beam")
    set_source_files_properties("${BEAM_SDK_PRELOAD_RESOURCE_DIR}/beams.rc" PROPERTIES
        OBJECT_DEPENDS "${_beam_seeds};${BEAM_SDK_PRELOAD_RESOURCE_DIR}/beam.rc")
else()
    string(JSON _beam_relative GET "${_beam_selected}" child_setup)
    beam_sdk_asset_path("${_beam_prefix}" "${_beam_relative}" _beam_helper)
    get_filename_component(BEAM_SDK_CHILD_SETUP_DIR "${_beam_helper}" DIRECTORY)
    if(NOT TARGET BEAM::ChildSetup)
        add_executable(BEAM::ChildSetup IMPORTED GLOBAL)
        set_property(TARGET BEAM::ChildSetup PROPERTY IMPORTED_LOCATION "${_beam_helper}")
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/BEAMInstall.cmake")
check_required_components(BEAM)
