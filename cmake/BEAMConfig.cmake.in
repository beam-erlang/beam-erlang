@PACKAGE_INIT@

# Runtime-only discovery does not require any separately deployed component.
set(BEAM_SDK_METADATA "${PACKAGE_PREFIX_DIR}/lib/beam/sdk.toml")
set(BEAM_HOST_MODULE "${PACKAGE_PREFIX_DIR}/lib/beam/ebin/beam_host.beam")
set(BEAM_BASE_MODULES beam beam_list beam_map beam_bytes beam_text beam_format beam_time)
set(BEAM_COMPONENT_DIR "${PACKAGE_PREFIX_DIR}/lib")
set(BEAM_SDK_BUILD_ID "@BEAM_COMPONENT_BUILD_ID@")
set(BEAM_BASE_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/lib/beam/library")
set(BEAM_BASE_MANIFEST "${BEAM_BASE_INVENTORY_DIR}/modules.txt")
set(BEAM_BASE_EBIN_DIR "${BEAM_BASE_INVENTORY_DIR}/ebin")
set(BEAM_BASE_INVENTORY_HEADER "${PACKAGE_PREFIX_DIR}/include/beam_base_inventory.h")
set(BEAM_BOOT_MODULES beam_return_boot beam_boot)
set(BEAM_BOOT_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/lib/beam/boot")
set(BEAM_BOOT_MANIFEST "${BEAM_BOOT_INVENTORY_DIR}/modules.txt")
set(BEAM_BOOT_EBIN_DIR "${BEAM_BOOT_INVENTORY_DIR}/ebin")
set(BEAM_BOOT_INVENTORY_HEADER "${PACKAGE_PREFIX_DIR}/include/beam_boot_inventory.h")
set(BEAM_SERVICES_MODULES beam_component_services beam_host beam_output beam_code)
set(BEAM_SERVICES_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/lib/beam/services")
set(BEAM_SERVICES_MANIFEST "${BEAM_SERVICES_INVENTORY_DIR}/modules.txt")
set(BEAM_SERVICES_EBIN_DIR "${BEAM_SERVICES_INVENTORY_DIR}/ebin")
set(BEAM_SERVICES_INVENTORY_HEADER "${PACKAGE_PREFIX_DIR}/include/beam_services_inventory.h")
set(BEAM_FILE_COMPONENT "${PACKAGE_PREFIX_DIR}/@BEAM_FILE_RELATIVE@")
set(BEAM_NETWORK_COMPONENT "${PACKAGE_PREFIX_DIR}/@BEAM_NETWORK_RELATIVE@")
include("${CMAKE_CURRENT_LIST_DIR}/BEAMTargets.cmake")
set(BEAM_Runtime_FOUND FALSE)
set(BEAM_RuntimeStatic_FOUND FALSE)
if(EXISTS "${PACKAGE_PREFIX_DIR}/@BEAM_RUNTIME_RELATIVE@")
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMSharedTargets.cmake")
    set(BEAM_Runtime_FOUND TRUE)
endif()
if(EXISTS "${PACKAGE_PREFIX_DIR}/@BEAM_STATIC_RELATIVE@")
    set(BEAM_RuntimeStatic_FOUND TRUE)
endif()
set(BEAM_NIF_FOUND TRUE)
set(BEAM_Driver_FOUND TRUE)
set(BEAM_CLI_FOUND FALSE)
if(BEAM_Runtime_FOUND AND EXISTS "${PACKAGE_PREFIX_DIR}/bin/beam@CMAKE_EXECUTABLE_SUFFIX@")
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMCLITargets.cmake")
    set(BEAM_CLI_FOUND TRUE)
endif()
if(BEAM_FIND_REQUIRED_CLI AND NOT BEAM_CLI_FOUND)
    set(BEAM_NOT_FOUND_MESSAGE "The required BEAM CLI component is not installed")
endif()
check_required_components(BEAM)

include("${CMAKE_CURRENT_LIST_DIR}/BEAMBytecode.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/BEAMDeployment.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/BEAMNif.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/BEAMRuntimeArtifacts.cmake")

if(BEAM_RuntimeStatic_FOUND)
    # Validate the archive and link-support closure before evaluating its exports.
    beam_get_runtime_artifact(_beam_static NAME runtime.static)
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMStaticTargets.cmake")
endif()
