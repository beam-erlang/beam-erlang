set(BEAM_TARGET_LIBC ucrt)
set(BEAM_PLATFORM_TRIPLE w64-mingw32)
if(MSVC)
    set(BEAM_PLATFORM_TRIPLE pc-windows-msvc)
endif()
set(BEAM_SYSTEM_LIBRARIES ws2_32 advapi32 bcrypt iphlpapi psapi)
set(BEAM_CXX_RUNTIME "")
if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(BEAM_CXX_RUNTIME stdc++ gcc_s)
endif()
set(BEAM_LOADER_ORIGIN "")
set(BEAM_SYS_DIRECTORY win32)
set(BEAM_THREAD_DIRECTORY win)
set(BEAM_PLATFORM_DEFINITIONS USE_THREADS __WIN32__ WIN32
    _CRT_SECURE_NO_WARNINGS _WIN32_WINNT=0x0A00 WINVER=0x0A00)
if(MSVC)
    list(APPEND BEAM_PLATFORM_DEFINITIONS ERTS_MIXED_VC)
    if(ERTS_BUILD_FLAVOR STREQUAL "emu")
        # The retained interpreter has a switch dispatcher for compilers that
        # do not implement GNU labels as values.
        list(APPEND BEAM_PLATFORM_DEFINITIONS NO_JUMP_TABLE)
    endif()
endif()
set(BEAM_HAS_CHILD_SETUP OFF)
set(CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS ON)
