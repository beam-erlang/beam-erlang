# All probes use the target compiler/sysroot, including cross builds.
if(WIN32)
    set(HAVE_WINDOWS_H 1)
    set(ETHR_WIN32_THREADS 1)
else()
    foreach(_header IN ITEMS sys/time.h sys/types.h sys/socket.h sys/mman.h sys/uio.h
            sys/un.h sys/ioctl.h fcntl.h dlfcn.h poll.h ifaddrs.h unistd.h stdlib.h
            syslog.h stdio.h string.h errno.h dirent.h net/if.h arpa/inet.h
            netinet/in.h netinet/tcp.h netdb.h netpacket/packet.h linux/falloc.h)
        string(TOUPPER "${_header}" _key)
        string(REGEX REPLACE "[/\\.]" "_" _key "${_key}")
        check_include_file("${_header}" BEAM_PROBE_${_key})
        set(HAVE_${_key} "${BEAM_PROBE_${_key}}")
    endforeach()
    foreach(_symbol IN ITEMS mmap mremap posix_memalign poll writev sendfile
            getaddrinfo getnameinfo getifaddrs if_nametoindex strerror gettimeofday
            posix_fallocate fallocate inet_pton if_nameindex if_indextoname
            if_freenameindex recvmmsg sendmmsg)
        string(TOUPPER "${_symbol}" _key)
        set(_headers "sys/types.h;sys/socket.h;sys/mman.h;sys/uio.h;sys/time.h;stdlib.h;string.h;unistd.h;fcntl.h;poll.h;netdb.h;net/if.h;arpa/inet.h;ifaddrs.h")
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR ANDROID)
            string(APPEND _headers ";sys/sendfile.h")
        endif()
        set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
        check_symbol_exists(${_symbol} "${_headers}" BEAM_PROBE_${_key})
        unset(CMAKE_REQUIRED_DEFINITIONS)
        set(HAVE_${_key} "${BEAM_PROBE_${_key}}")
    endforeach()
    set(HAVE_DLOPEN 1)
    set(ERTS_USE_POLL 1)
    set(HAVE_IN6 1)
    set(HAVE_IPV6 1)
    set(HAVE_SOCKLEN_T 1)
    set(ETHR_HAVE_SCHED_YIELD 1)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR ANDROID)
        check_include_file("sys/epoll.h" HAVE_SYS_EPOLL_H)
        if(NOT HAVE_SYS_EPOLL_H)
            message(FATAL_ERROR "Linux/Android requires epoll")
        endif()
        set(ETHR_HAVE_LINUX_FUTEX 1)
        set(ERTS_ENABLE_KERNEL_POLL 1)
    elseif(APPLE)
        check_include_file("sys/event.h" HAVE_SYS_EVENT_H)
        set(ERTS_ENABLE_KERNEL_POLL 1)
        set(HAVE_KQUEUE 1)
    endif()
endif()
