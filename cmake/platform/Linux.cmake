if(NOT BEAM_TARGET_LIBC)
    include(CheckCSourceCompiles)
    check_c_source_compiles("#include <features.h>\n#ifndef __GLIBC__\n#error not glibc\n#endif\nint main(void) {return 0;}" BEAM_HAS_GLIBC)
    if(BEAM_HAS_GLIBC)
        set(BEAM_TARGET_LIBC glibc CACHE STRING "Target C library" FORCE)
    else()
        set(BEAM_TARGET_LIBC musl CACHE STRING "Target C library" FORCE)
    endif()
endif()
if(NOT BEAM_TARGET_LIBC MATCHES "^(glibc|musl)$")
    message(FATAL_ERROR "Linux target libc must be glibc or musl")
endif()
set(BEAM_PLATFORM_TRIPLE pc-linux-gnu)
if(BEAM_TARGET_LIBC STREQUAL musl)
    set(BEAM_PLATFORM_TRIPLE linux-musl)
endif()
set(BEAM_SYSTEM_LIBRARIES m ${CMAKE_DL_LIBS} pthread)
set(BEAM_CXX_RUNTIME stdc++)
set(BEAM_LOADER_ORIGIN "$ORIGIN")
set(BEAM_SYS_DIRECTORY unix)
set(BEAM_THREAD_DIRECTORY pthread)
set(BEAM_PLATFORM_DEFINITIONS USE_THREADS _THREAD_SAFE _REENTRANT _GNU_SOURCE POSIX_THREADS _POSIX_THREAD_SAFE_FUNCTIONS)
set(BEAM_HAS_CHILD_SETUP ON)
