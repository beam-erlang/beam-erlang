check_c_source_compiles("#include <pthread.h>\nint main(void) { return PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP; }"
    ETHR_HAVE_PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP)
check_symbol_exists(pthread_yield "pthread.h" ETHR_HAVE_PTHREAD_YIELD)
unset(CMAKE_REQUIRED_DEFINITIONS)
set(ETHR_SCHED_YIELD_RET_INT 1)

