include_guard(GLOBAL)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
if(CMAKE_OSX_ARCHITECTURES)
    set(_processor "${CMAKE_OSX_ARCHITECTURES}")
endif()
if(_processor MATCHES "^(x86_64|amd64)$")
    set(BEAM_TARGET_ARCH amd64)
    set(ERTS_TARGET_ARCH x86)
elseif(_processor MATCHES "^(aarch64|arm64)$")
    set(BEAM_TARGET_ARCH arm64)
    set(ERTS_TARGET_ARCH arm)
else()
    message(FATAL_ERROR "Unsupported target architecture: ${_processor}")
endif()
if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Windows|Darwin|Android|iOS)$")
    message(FATAL_ERROR "Unsupported target OS: ${CMAKE_SYSTEM_NAME}")
endif()
set(BEAM_TARGET_LIBC "" CACHE STRING "Target C library (glibc or musl on Linux)")
set(BEAM_TARGET_MINIMUM "" CACHE STRING "Declared target deployment baseline")
include("${CMAKE_CURRENT_LIST_DIR}/platform/${CMAKE_SYSTEM_NAME}.cmake")
if(NOT DEFINED ERTS_HOST_TRIPLE OR ERTS_HOST_TRIPLE STREQUAL "")
    set(ERTS_HOST_TRIPLE "${_processor}-${BEAM_PLATFORM_TRIPLE}")
endif()
set(ERTS_HOST_TRIPLE "${ERTS_HOST_TRIPLE}" CACHE STRING "Target triple reported by ERTS")
set(BEAM_BUILD_CLI_DEFAULT ON)
if(CMAKE_SYSTEM_NAME MATCHES "^(iOS|Android)$")
    set(BEAM_BUILD_CLI_DEFAULT OFF)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    if(ERTS_BUILD_FLAVOR STREQUAL "jit")
        message(FATAL_ERROR "iOS targets require the interpreter flavor")
    endif()
endif()
option(BEAM_BUILD_CLI "Build target command-line executables" ${BEAM_BUILD_CLI_DEFAULT})
if(CMAKE_SYSTEM_NAME MATCHES "^(iOS|Android)$" AND BEAM_BUILD_CLI)
    message(FATAL_ERROR "Mobile SDKs do not contain target CLI executables")
endif()
