# Supported acquisition and deployment of fixed matching-build VM artifacts.
# This does not expose a native provider ABI or select an Erlang composition.
include_guard(GLOBAL)

get_filename_component(_BEAM_ARTIFACT_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(BEAM_RUNTIME_ARTIFACTS_METADATA "${_BEAM_ARTIFACT_PREFIX}/lib/beam/runtime-artifacts.json")
if(NOT EXISTS "${BEAM_RUNTIME_ARTIFACTS_METADATA}")
    message(FATAL_ERROR "BEAM SDK lacks runtime artifact metadata: ${BEAM_RUNTIME_ARTIFACTS_METADATA}")
endif()
file(READ "${BEAM_RUNTIME_ARTIFACTS_METADATA}" _BEAM_ARTIFACT_JSON)

function(_beam_artifact_json out)
    string(JSON _value ERROR_VARIABLE _error GET "${_BEAM_ARTIFACT_JSON}" ${ARGN})
    if(NOT _error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Invalid BEAM runtime artifact metadata: ${_error}")
    endif()
    set(${out} "${_value}" PARENT_SCOPE)
endfunction()

_beam_artifact_json(_format format)
if(NOT _format EQUAL 1)
    message(FATAL_ERROR "Unsupported BEAM runtime artifact metadata format: ${_format}")
endif()
_beam_artifact_json(BEAM_SDK_VERSION version)
_beam_artifact_json(BEAM_SDK_FLAVOR flavor)
_beam_artifact_json(BEAM_SDK_BUILD_ID build-id)
_beam_artifact_json(BEAM_SDK_ARCHITECTURE architecture)
_beam_artifact_json(BEAM_SDK_TRIPLE triple)
_beam_artifact_json(_metadata_hash sdk-metadata-sha256)
file(SHA256 "${_BEAM_ARTIFACT_PREFIX}/lib/beam/sdk.toml" _actual_metadata_hash)
if(NOT _metadata_hash STREQUAL _actual_metadata_hash)
    message(FATAL_ERROR "BEAM SDK metadata does not match its runtime artifact inventory")
endif()
foreach(_pair IN ITEMS "identity|VERSION" "flavor|FLAVOR" "build-id|BUILD_ID"
        "architecture|ARCHITECTURE" "triple|TRIPLE")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _key)
    list(GET _pair 1 _field)
    file(STRINGS "${_BEAM_ARTIFACT_PREFIX}/lib/beam/sdk.toml" _entry REGEX "^${_key} = ")
    list(LENGTH _entry _entry_count)
    if(NOT _entry_count EQUAL 1 OR NOT _entry MATCHES "^${_key} = \"([^\"]+)\"$")
        message(FATAL_ERROR "Invalid BEAM SDK metadata field: ${_key}")
    endif()
    if(NOT CMAKE_MATCH_1 STREQUAL BEAM_SDK_${_field})
        message(FATAL_ERROR "BEAM SDK ${_key} disagrees with its runtime artifact inventory")
    endif()
endforeach()
string(LENGTH "${BEAM_SDK_BUILD_ID}" _identity_length)
if(NOT _identity_length EQUAL 64 OR NOT BEAM_SDK_BUILD_ID MATCHES "^[a-f0-9]+$"
        OR NOT BEAM_SDK_FLAVOR MATCHES "^(emu|jit)$")
    message(FATAL_ERROR "Invalid BEAM SDK runtime artifact identity or flavor")
endif()
string(JSON _count LENGTH "${_BEAM_ARTIFACT_JSON}" artifacts)
set(BEAM_RUNTIME_ARTIFACTS)
if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _id MEMBER "${_BEAM_ARTIFACT_JSON}" artifacts ${_index})
        list(APPEND BEAM_RUNTIME_ARTIFACTS "${_id}")
    endforeach()
endif()

function(beam_check_runtime_sdk)
    cmake_parse_arguments(PARSE_ARGV 0 SDK "" "VERSION;FLAVOR;BUILD_ID" "")
    if(SDK_UNPARSED_ARGUMENTS OR SDK_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "beam_check_runtime_sdk accepts VERSION, FLAVOR and BUILD_ID")
    endif()
    foreach(_field IN ITEMS VERSION FLAVOR BUILD_ID)
        if(DEFINED SDK_${_field} AND NOT SDK_${_field} STREQUAL BEAM_SDK_${_field})
            message(FATAL_ERROR "BEAM SDK ${_field} mismatch: requested '${SDK_${_field}}', installed '${BEAM_SDK_${_field}}'")
        endif()
    endforeach()
endfunction()

function(_beam_validate_artifact id out_path)
    if(NOT id IN_LIST BEAM_RUNTIME_ARTIFACTS)
        message(FATAL_ERROR "BEAM SDK runtime artifact is unavailable: ${id}")
    endif()
    _beam_artifact_json(_relative artifacts "${id}" path)
    if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "(^|/)\\.\\.(/|$)" OR _relative MATCHES "[;\\\\]")
        message(FATAL_ERROR "Invalid BEAM runtime artifact path: ${id}")
    endif()
    set(_path "${_BEAM_ARTIFACT_PREFIX}/${_relative}")
    if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
        message(FATAL_ERROR "BEAM SDK runtime artifact is missing: ${id} (${_path})")
    endif()
    _beam_artifact_json(_expected artifacts "${id}" sha256)
    # Many selected NIFs share the runtime. Hash each artifact once per CMake
    # invocation, never cache verification across configuration runs.
    string(SHA256 _verification_key "${_path}|${BEAM_SDK_BUILD_ID}|${_expected}")
    get_property(_verified GLOBAL PROPERTY "_BEAM_ARTIFACT_VERIFIED_${_verification_key}")
    if(NOT _verified)
        file(SHA256 "${_path}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "BEAM SDK runtime artifact does not match its build inventory: ${id}")
        endif()
        set_property(GLOBAL PROPERTY "_BEAM_ARTIFACT_VERIFIED_${_verification_key}" TRUE)
    endif()
    set(${out_path} "${_path}" PARENT_SCOPE)
endfunction()

function(_beam_runtime_artifact_closure out)
    set(_pending ${ARGN})
    set(_selected)
    while(_pending)
        list(POP_FRONT _pending _id)
        if(_id IN_LIST _selected)
            continue()
        endif()
        _beam_validate_artifact("${_id}" _path)
        list(APPEND _selected "${_id}")
        string(JSON _count LENGTH "${_BEAM_ARTIFACT_JSON}" artifacts "${_id}" requires)
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_index RANGE 0 ${_last})
                _beam_artifact_json(_dependency artifacts "${_id}" requires ${_index})
                list(APPEND _pending "${_dependency}")
            endforeach()
        endif()
    endwhile()
    list(SORT _selected)
    set(${out} "${_selected}" PARENT_SCOPE)
endfunction()

function(beam_get_runtime_artifact out)
    cmake_parse_arguments(PARSE_ARGV 1 ART "RELATIVE" "NAME;KIND" "")
    if(ART_UNPARSED_ARGUMENTS OR ART_KEYWORDS_MISSING_VALUES OR NOT ART_NAME)
        message(FATAL_ERROR "beam_get_runtime_artifact requires NAME and accepts KIND and RELATIVE")
    endif()
    _beam_runtime_artifact_closure(_closure "${ART_NAME}")
    _beam_artifact_json(_kind artifacts "${ART_NAME}" kind)
    if(ART_KIND AND NOT ART_KIND STREQUAL _kind)
        message(FATAL_ERROR "BEAM runtime artifact kind mismatch for ${ART_NAME}: requested ${ART_KIND}, installed ${_kind}")
    endif()
    _beam_artifact_json(_relative artifacts "${ART_NAME}" path)
    if(ART_RELATIVE)
        set(${out} "${_relative}" PARENT_SCOPE)
    else()
        set(${out} "${_BEAM_ARTIFACT_PREFIX}/${_relative}" PARENT_SCOPE)
    endif()
endfunction()

function(beam_install_runtime_artifacts)
    cmake_parse_arguments(PARSE_ARGV 0 DEP "" "DESTINATION" "ARTIFACTS")
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES OR NOT DEP_ARTIFACTS)
        message(FATAL_ERROR "beam_install_runtime_artifacts requires ARTIFACTS and accepts DESTINATION")
    endif()
    if(NOT DEFINED DEP_DESTINATION)
        set(DEP_DESTINATION ".")
    endif()
    if(IS_ABSOLUTE "${DEP_DESTINATION}" OR DEP_DESTINATION MATCHES "(^|/)\\.\\.(/|$)" OR DEP_DESTINATION MATCHES "[;\\\\]")
        message(FATAL_ERROR "BEAM runtime artifact deployment requires a relative destination without parent traversal")
    endif()
    _beam_runtime_artifact_closure(_closure ${DEP_ARTIFACTS})
    foreach(_id IN LISTS _closure)
        _beam_artifact_json(_relative artifacts "${_id}" path)
        _beam_artifact_json(_kind artifacts "${_id}" kind)
        _beam_artifact_json(_expected artifacts "${_id}" sha256)
        set(_source "${_BEAM_ARTIFACT_PREFIX}/${_relative}")
        get_filename_component(_directory "${_relative}" DIRECTORY)
        # Check again at install time: a reinstalled SDK must not silently change
        # the identity of a previously configured product.
        install(CODE "file(SHA256 [==[${_source}]==] _actual)\nif(NOT _actual STREQUAL [==[${_expected}]==])\n  message(FATAL_ERROR [==[BEAM runtime artifact changed after configuration: ${_id}]==])\nendif()")
        if(_kind STREQUAL "executable-helper")
            install(PROGRAMS "${_source}" DESTINATION "${DEP_DESTINATION}/${_directory}")
        else()
            install(FILES "${_source}" DESTINATION "${DEP_DESTINATION}/${_directory}")
        endif()
    endforeach()
endfunction()

# Install the public extension ABI into a distribution-owned include directory.
# Consumers do not reconstruct this inventory or use source-tree VM headers.
function(beam_install_native_headers)
    cmake_parse_arguments(PARSE_ARGV 0 HEADERS "" "DESTINATION" "ARTIFACTS")
    if(HEADERS_UNPARSED_ARGUMENTS OR HEADERS_KEYWORDS_MISSING_VALUES OR NOT HEADERS_DESTINATION)
        message(FATAL_ERROR "beam_install_native_headers requires DESTINATION")
    endif()
    if(IS_ABSOLUTE "${HEADERS_DESTINATION}" OR HEADERS_DESTINATION MATCHES "(^|/)\\.\\.(/|$)" OR HEADERS_DESTINATION MATCHES "[;\\\\]")
        message(FATAL_ERROR "Native headers require a relative destination without parent traversal")
    endif()
    if(NOT HEADERS_ARTIFACTS)
        set(HEADERS_ARTIFACTS header.erl_nif header.erl_driver)
    endif()
    _beam_runtime_artifact_closure(_headers ${HEADERS_ARTIFACTS})
    foreach(_id IN LISTS _headers)
        beam_get_runtime_artifact(_source NAME "${_id}" KIND native-header)
        _beam_artifact_json(_expected artifacts "${_id}" sha256)
        install(CODE "file(SHA256 [==[${_source}]==] _actual)\nif(NOT _actual STREQUAL [==[${_expected}]==])\n  message(FATAL_ERROR [==[BEAM native header changed after configuration: ${_id}]==])\nendif()")
        install(FILES "${_source}" DESTINATION "${HEADERS_DESTINATION}")
    endforeach()
endfunction()

# Deploy the SDK-owned embedded-core inventory for distribution tooling.
# The VM already embeds these bytes; this does not load or replace code.
function(beam_install_core_modules)
    cmake_parse_arguments(PARSE_ARGV 0 CORE "" "DESTINATION;SOURCE_DESTINATION" "")
    if(CORE_UNPARSED_ARGUMENTS OR CORE_KEYWORDS_MISSING_VALUES OR NOT CORE_DESTINATION)
        message(FATAL_ERROR "beam_install_core_modules requires DESTINATION")
    endif()
    if(IS_ABSOLUTE "${CORE_DESTINATION}" OR CORE_DESTINATION MATCHES "(^|/)\\.\\.(/|$)" OR CORE_DESTINATION MATCHES "[;\\\\]")
        message(FATAL_ERROR "Core modules require a relative destination without parent traversal")
    endif()
    set(_selected)
    foreach(_id IN LISTS BEAM_RUNTIME_ARTIFACTS)
        _beam_artifact_json(_kind artifacts "${_id}" kind)
        if(_kind STREQUAL "core-module")
            list(APPEND _selected "${_id}")
        endif()
    endforeach()
    if(NOT _selected)
        message(FATAL_ERROR "BEAM SDK lacks embedded-core module artifacts")
    endif()
    if(CORE_SOURCE_DESTINATION)
        if(IS_ABSOLUTE "${CORE_SOURCE_DESTINATION}" OR CORE_SOURCE_DESTINATION MATCHES "(^|/)\\.\\.(/|$)" OR CORE_SOURCE_DESTINATION MATCHES "[;\\\\]")
            message(FATAL_ERROR "Core sources require a relative destination without parent traversal")
        endif()
        foreach(_module IN LISTS _selected)
            string(REGEX REPLACE "^core\\." "core-source." _id "${_module}")
            beam_get_runtime_artifact(_source NAME "${_id}" KIND core-source)
            _beam_artifact_json(_expected artifacts "${_id}" sha256)
            install(CODE "file(SHA256 [==[${_source}]==] _actual)\nif(NOT _actual STREQUAL [==[${_expected}]==])\n  message(FATAL_ERROR [==[BEAM core source changed after configuration: ${_id}]==])\nendif()")
            install(FILES "${_source}" DESTINATION "${CORE_SOURCE_DESTINATION}")
        endforeach()
    endif()
    foreach(_id IN LISTS _selected)
        beam_get_runtime_artifact(_source NAME "${_id}" KIND core-module)
        _beam_artifact_json(_expected artifacts "${_id}" sha256)
        install(CODE "file(SHA256 [==[${_source}]==] _actual)\nif(NOT _actual STREQUAL [==[${_expected}]==])\n  message(FATAL_ERROR [==[BEAM core module changed after configuration: ${_id}]==])\nendif()")
        install(FILES "${_source}" DESTINATION "${CORE_DESTINATION}")
    endforeach()
endfunction()
