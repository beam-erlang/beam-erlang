@PACKAGE_INIT@

# Runtime-only discovery does not require any separately deployed component.
set(BEAM_SDK_METADATA "${PACKAGE_PREFIX_DIR}/lib/beam/sdk.toml")
set(BEAM_TARGET_METADATA "${PACKAGE_PREFIX_DIR}/lib/beam/target.toml")
set(BEAM_HOST_MODULE "${PACKAGE_PREFIX_DIR}/lib/beam/ebin/beam_host.beam")
set(BEAM_SDK_INVENTORIES_HEADER "${PACKAGE_PREFIX_DIR}/include/beam/sdk/inventories.h")
set(BEAM_BASE_MODULES @BEAM_BASE_MODULES@)
set(BEAM_SDK_BUILD_ID "@BEAM_COMPONENT_BUILD_ID@")
set(BEAM_APPLICATION_TOOL "${PACKAGE_PREFIX_DIR}/share/beam/tools/beam-application.py")
set(BEAM_APPLICATION_LAUNCHER "${PACKAGE_PREFIX_DIR}/bin/beam-launch@CMAKE_EXECUTABLE_SUFFIX@")
set(BEAM_BASE_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/@BEAM_BASE_INSTALL_ROOT@")
set(BEAM_BASE_MANIFEST "${BEAM_BASE_INVENTORY_DIR}/modules.txt")
set(BEAM_BASE_EBIN_DIR "${BEAM_BASE_INVENTORY_DIR}/ebin")
set(BEAM_BOOT_MODULES @BEAM_BOOT_MODULES@)
set(BEAM_BOOT_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/@BEAM_BOOT_INSTALL_ROOT@")
set(BEAM_BOOT_MANIFEST "${BEAM_BOOT_INVENTORY_DIR}/modules.txt")
set(BEAM_BOOT_EBIN_DIR "${BEAM_BOOT_INVENTORY_DIR}/ebin")
set(BEAM_SERVICES_MODULES @BEAM_SERVICES_MODULES@)
set(BEAM_SERVICES_INVENTORY_DIR "${PACKAGE_PREFIX_DIR}/@BEAM_SERVICES_INSTALL_ROOT@")
set(BEAM_SERVICES_MANIFEST "${BEAM_SERVICES_INVENTORY_DIR}/modules.txt")
set(BEAM_SERVICES_EBIN_DIR "${BEAM_SERVICES_INVENTORY_DIR}/ebin")
include("${CMAKE_CURRENT_LIST_DIR}/BEAMTargets.cmake")
set(BEAM_Runtime_FOUND FALSE)
set(BEAM_RuntimeStatic_FOUND FALSE)
if(BEAM_ANDROID_PREFAB)
    include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMAndroid.cmake")
    _beam_android_runtime()
    set(BEAM_Runtime_FOUND TRUE)
elseif(EXISTS "${PACKAGE_PREFIX_DIR}/@BEAM_RUNTIME_RELATIVE@")
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMSharedTargets.cmake")
    set(BEAM_Runtime_FOUND TRUE)
endif()
if(NOT BEAM_ANDROID_PREFAB AND EXISTS "${PACKAGE_PREFIX_DIR}/@BEAM_STATIC_RELATIVE@")
    set(BEAM_RuntimeStatic_FOUND TRUE)
endif()
set(BEAM_NIF_FOUND TRUE)
set(BEAM_Host_FOUND FALSE)
if(EXISTS "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@beam-host@CMAKE_STATIC_LIBRARY_SUFFIX@")
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMHostTargets.cmake")
    set(BEAM_Host_FOUND TRUE)
endif()
set(BEAM_Driver_FOUND TRUE)
set(BEAM_CLI_FOUND FALSE)
if(BEAM_Runtime_FOUND AND EXISTS "${PACKAGE_PREFIX_DIR}/bin/beam@CMAKE_EXECUTABLE_SUFFIX@")
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMCLITargets.cmake")
    set(BEAM_CLI_FOUND TRUE)
endif()
if(BEAM_FIND_REQUIRED_CLI AND NOT BEAM_CLI_FOUND)
    set(BEAM_NOT_FOUND_MESSAGE "The required BEAM CLI component is not installed")
endif()
check_required_components(BEAM)

include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMBytecode.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMDeployment.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMNif.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMLibrary.cmake" OPTIONAL)

include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMRuntimeArtifacts.cmake")
# Retain the selected catalog for deferred support checks through target graphs.
foreach(_field IN ITEMS _BEAM_ARTIFACT_JSON _BEAM_ARTIFACT_PREFIX BEAM_RUNTIME_ARTIFACTS BEAM_SDK_BUILD_ID)
    set_property(TARGET BEAM::SDKSupport PROPERTY "${_field}" "${${_field}}")
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMTarget.cmake")
beam_check_native_target()
# Also cover consumers enabling a native language after package discovery.
cmake_language(DEFER CALL beam_check_native_target)

if(BEAM_RuntimeStatic_FOUND)
    # Validate the archive and link-support closure before evaluating its exports.
    beam_get_runtime_artifact(_beam_static NAME runtime.static)
    include("${CMAKE_CURRENT_LIST_DIR}/BEAMStaticTargets.cmake")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMiOS.cmake")
elseif(ANDROID)
    include("${CMAKE_CURRENT_LIST_DIR}/support/BEAMAndroid.cmake")
endif()

# Each native library and linkage form is independently optional.
foreach(_library file network zlib)
    if(EXISTS "${PACKAGE_PREFIX_DIR}/@_component_install_dir@/@CMAKE_SHARED_LIBRARY_PREFIX@beam-${_library}@CMAKE_SHARED_LIBRARY_SUFFIX@" OR
       EXISTS "${PACKAGE_PREFIX_DIR}/lib/BEAM${_library}.framework/BEAM${_library}")
        include("${CMAKE_CURRENT_LIST_DIR}/BEAM${_library}SharedTargets.cmake")
    endif()
    if(EXISTS "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@beam-${_library}@CMAKE_STATIC_LIBRARY_SUFFIX@")
        include("${CMAKE_CURRENT_LIST_DIR}/BEAM${_library}StaticTargets.cmake")
    endif()
endforeach()
