# Compiler checks never execute target programs or acquire unrelated SDK assets.
include_guard(GLOBAL)

function(_beam_target_arch input output)
    string(TOLOWER "${input}" _arch)
    if(_arch MATCHES "^(x86_64|amd64)$")
        set(_arch amd64)
    elseif(_arch MATCHES "^(aarch64|arm64)$")
        set(_arch arm64)
    endif()
    set(${output} "${_arch}" PARENT_SCOPE)
endfunction()

# Read little-endian ELF fields using CMake alone; native SDK discovery needs no
# Python, readelf, target execution or executable loader on the build host.
function(_beam_elf_number hex offset width output)
    string(LENGTH "${hex}" _length)
    math(EXPR _end "(${offset} + ${width}) * 2")
    if(offset LESS 0 OR _end GREATER _length OR width GREATER 8)
        message(FATAL_ERROR "Invalid compiler target ELF probe")
    endif()
    set(_value 0)
    math(EXPR _last "${width} - 1")
    foreach(_byte RANGE ${_last} 0 -1)
        math(EXPR _at "(${offset} + ${_byte}) * 2")
        string(SUBSTRING "${hex}" ${_at} 2 _digit)
        math(EXPR _value "(${_value} << 8) | 0x${_digit}")
    endforeach()
    if(_value LESS 0)
        message(FATAL_ERROR "Invalid compiler target ELF field")
    endif()
    set(${output} ${_value} PARENT_SCOPE)
endfunction()

function(_beam_target_interpreter binary output)
    file(SIZE "${binary}" _size)
    if(_size LESS 64 OR _size GREATER 1048576)
        message(FATAL_ERROR "Invalid compiler target ELF size")
    endif()
    file(READ "${binary}" _hex HEX)
    string(SUBSTRING "${_hex}" 0 12 _magic)
    if(NOT _magic STREQUAL "7f454c460201")
        message(FATAL_ERROR "Linux compiler target probe must be little-endian ELF64")
    endif()
    _beam_elf_number("${_hex}" 32 8 _phoff)
    _beam_elf_number("${_hex}" 54 2 _phsize)
    _beam_elf_number("${_hex}" 56 2 _count)
    if(NOT _phsize EQUAL 56 OR _count LESS 1 OR _count GREATER 256)
        message(FATAL_ERROR "Invalid compiler target ELF program headers")
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        math(EXPR _header "${_phoff} + ${_index} * ${_phsize}")
        _beam_elf_number("${_hex}" ${_header} 4 _type)
        if(_type EQUAL 3)
            math(EXPR _at "${_header} + 8")
            _beam_elf_number("${_hex}" ${_at} 8 _offset)
            math(EXPR _at "${_header} + 32")
            _beam_elf_number("${_hex}" ${_at} 8 _length)
            math(EXPR _end "${_offset} + ${_length}")
            if(_length LESS 2 OR _length GREATER 256 OR _end GREATER _size)
                message(FATAL_ERROR "Invalid compiler target ELF interpreter")
            endif()
            file(READ "${binary}" _interpreter OFFSET ${_offset} LIMIT ${_length})
            string(STRIP "${_interpreter}" _interpreter)
            set(${output} "${_interpreter}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Linux libc verification requires a dynamically linked compiler probe")
endfunction()

function(beam_check_compiler_target)
    cmake_parse_arguments(PARSE_ARGV 0 T "" "SYSTEM;ARCHITECTURE;LIBC;COMPILER_ENVIRONMENT;DETECTED_LIBC" "")
    if(T_UNPARSED_ARGUMENTS OR T_KEYWORDS_MISSING_VALUES OR NOT T_SYSTEM OR NOT T_ARCHITECTURE)
        message(FATAL_ERROR "beam_check_compiler_target requires SYSTEM and ARCHITECTURE")
    endif()
    _beam_target_arch("${T_ARCHITECTURE}" _expected_arch)
    _beam_target_arch("${CMAKE_SYSTEM_PROCESSOR}" _actual_arch)
    if(NOT T_SYSTEM STREQUAL CMAKE_SYSTEM_NAME OR NOT _expected_arch STREQUAL _actual_arch)
        message(FATAL_ERROR "BEAM compiler target OS/architecture differs from selected SDK")
    endif()
    get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    foreach(_language IN ITEMS C CXX)
        if(NOT _language IN_LIST _languages)
            continue()
        endif()
        set(_environment "${CMAKE_${_language}_COMPILER_ID}")
        if(CMAKE_${_language}_SIMULATE_ID)
            string(APPEND _environment "-${CMAKE_${_language}_SIMULATE_ID}")
        elseif(MINGW)
            string(APPEND _environment "-MinGW")
        endif()
        if(T_COMPILER_ENVIRONMENT AND NOT _environment STREQUAL T_COMPILER_ENVIRONMENT)
            message(FATAL_ERROR "Native package compiler must match installed SDK")
        endif()
        set(_extension c)
        if(_language STREQUAL CXX)
            set(_extension cpp)
        endif()
        if(NOT T_SYSTEM STREQUAL "Linux")
            set(_arch_check "defined(__x86_64__) || defined(_M_X64)")
            if(_expected_arch STREQUAL arm64)
                set(_arch_check "defined(__aarch64__) || defined(_M_ARM64)")
            endif()
            set(_headers "")
            if(T_SYSTEM STREQUAL "Windows")
                set(_os_check "defined(_WIN32) && !defined(__CYGWIN__)")
            elseif(T_SYSTEM STREQUAL "Android")
                set(_os_check "defined(__ANDROID__)")
            elseif(T_SYSTEM MATCHES "^(Darwin|iOS)$")
                set(_headers "#include <TargetConditionals.h>\n")
                if(T_SYSTEM STREQUAL "iOS")
                    set(_os_check "defined(__APPLE__) && TARGET_OS_IPHONE")
                else()
                    set(_os_check "defined(__APPLE__) && !TARGET_OS_IPHONE")
                endif()
            else()
                message(FATAL_ERROR "Unsupported BEAM compiler target OS")
            endif()
            # Cross SDK toolchains may deliberately disable executable linking
            # during configuration. OS/CPU checks only require an object.
            set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
            try_compile(_ok SOURCE_FROM_CONTENT "beam-target.${_extension}"
                "${_headers}#if !(${_os_check}) || !(${_arch_check})\n#error Wrong compiler target\n#endif\nint beam_target_probe(void) { return 0; }\n"
                NO_CACHE OUTPUT_VARIABLE _output)
            if(NOT _ok)
                message(FATAL_ERROR "Cannot verify BEAM ${_language} compiler target: ${_output}")
            endif()
            continue()
        endif()
        set(_arch_check "defined(__x86_64__)")
        set(_musl_arch x86_64)
        if(_expected_arch STREQUAL arm64)
            set(_arch_check "defined(__aarch64__)")
            set(_musl_arch aarch64)
        endif()
        set(_source "#include <features.h>\n#if !defined(__linux__) || defined(__ANDROID__) || !(${_arch_check})\n#error Wrong Linux compiler target\n#endif\nint main(void) { return 0; }\n")
        # This function deliberately does not cache a result across compiler,
        # language, flags or sysroot changes in an existing consumer build.
        set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
        set(_binary "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/beam-${_language}-target")
        try_compile(_ok SOURCE_FROM_CONTENT "beam-target.${_extension}" "${_source}"
            COPY_FILE "${_binary}" NO_CACHE OUTPUT_VARIABLE _output)
        if(NOT _ok)
            message(FATAL_ERROR "Cannot verify BEAM ${_language} compiler target: ${_output}")
        endif()
        _beam_target_interpreter("${_binary}" _interpreter)
        if(_interpreter STREQUAL "/lib/ld-musl-${_musl_arch}.so.1")
            set(_libc musl)
            set(_libc_check "#ifdef __GLIBC__\n#error musl compiler has glibc headers\n#endif\n")
        elseif((_musl_arch STREQUAL x86_64 AND _interpreter MATCHES "/ld-linux-x86-64[.]so[.]2$") OR
                (_musl_arch STREQUAL aarch64 AND _interpreter MATCHES "/ld-linux-aarch64[.]so[.]1$"))
            set(_libc glibc)
            set(_libc_check "#ifndef __GLIBC__\n#error Unrecognized Linux libc\n#endif\n")
        else()
            message(FATAL_ERROR "Unrecognized Linux compiler libc interpreter: ${_interpreter}")
        endif()
        try_compile(_headers SOURCE_FROM_CONTENT "beam-libc.${_extension}" "#include <features.h>\n${_libc_check}int main(void) { return 0; }\n"
            NO_CACHE OUTPUT_VARIABLE _output)
        if(NOT _headers OR (T_LIBC AND NOT T_LIBC STREQUAL _libc) OR
                (DEFINED _previous_libc AND NOT _previous_libc STREQUAL _libc))
            message(FATAL_ERROR "BEAM ${_language} compiler libc mismatch: expected '${T_LIBC}', detected '${_libc}' (${_interpreter})")
        endif()
        set(_previous_libc "${_libc}")
    endforeach()
    if(T_DETECTED_LIBC AND DEFINED _previous_libc)
        set(${T_DETECTED_LIBC} "${_previous_libc}" PARENT_SCOPE)
    endif()
endfunction()

function(beam_read_target_metadata output)
    beam_get_runtime_artifact(_target NAME sdk.target KIND target-metadata)
    foreach(_field IN ITEMS format sdk-build-id system architecture processor abi libc compiler-environment baseline compiler-generation)
        file(STRINGS "${_target}" _lines REGEX "^${_field} = ")
        list(LENGTH _lines _count)
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "Invalid BEAM SDK target field: ${_field}")
        endif()
        if(_field STREQUAL format)
            if(NOT _lines STREQUAL "format = 1")
                message(FATAL_ERROR "Unsupported BEAM SDK target format")
            endif()
        elseif(_lines MATCHES "^${_field} = \"([^\"]*)\"$")
            set(_${_field} "${CMAKE_MATCH_1}")
            set(${output}_${_field} "${CMAKE_MATCH_1}" PARENT_SCOPE)
        else()
            message(FATAL_ERROR "Invalid BEAM SDK target field: ${_field}")
        endif()
    endforeach()
    if(NOT _sdk-build-id STREQUAL BEAM_SDK_BUILD_ID OR NOT _abi STREQUAL BEAM_SDK_TRIPLE)
        message(FATAL_ERROR "SDK target metadata selects a different build or ABI")
    endif()
    beam_get_runtime_artifact(_compiler NAME compiler.generation KIND compiler-provenance)
    file(SHA256 "${_compiler}" _generation)
    if(NOT _generation STREQUAL _compiler-generation)
        message(FATAL_ERROR "SDK compiler generation disagrees with its attestation")
    endif()
endfunction()

function(beam_check_native_target)
    cmake_parse_arguments(PARSE_ARGV 0 T "MATCH_COMPILER" "" "")
    if(T_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "beam_check_native_target accepts MATCH_COMPILER")
    endif()
    get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
    if(NOT "C" IN_LIST _languages AND NOT "CXX" IN_LIST _languages)
        return()
    endif()
    beam_read_target_metadata(_target)
    set(_compiler)
    if(T_MATCH_COMPILER)
        set(_compiler COMPILER_ENVIRONMENT "${_target_compiler-environment}")
    endif()
    beam_check_compiler_target(SYSTEM "${_target_system}" ARCHITECTURE "${_target_architecture}"
        LIBC "${_target_libc}" ${_compiler})
endfunction()
