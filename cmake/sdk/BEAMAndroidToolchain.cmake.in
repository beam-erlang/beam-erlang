# SPDX-License-Identifier: Apache-2.0
# One immutable Android SDK selection; no host tools or implicit NDK acquisition.
if(NOT DEFINED ENV{ANDROID_NDK_ROOT} OR "$ENV{ANDROID_NDK_ROOT}" STREQUAL "")
    message(FATAL_ERROR "Select the SDK's NDK with ANDROID_NDK_ROOT")
endif()
file(REAL_PATH "$ENV{ANDROID_NDK_ROOT}" _beam_ndk)
file(STRINGS "${_beam_ndk}/source.properties" _beam_ndk_revision REGEX "^Pkg.Revision")
string(REGEX REPLACE "^Pkg.Revision[ =]+" "" _beam_ndk_revision "${_beam_ndk_revision}")
string(STRIP "${_beam_ndk_revision}" _beam_ndk_revision)
if(NOT _beam_ndk_revision STREQUAL "@BEAM_ANDROID_NDK_VERSION@")
    message(FATAL_ERROR "Android NDK revision differs from selected BEAM SDK")
endif()
foreach(_pair IN ITEMS "ANDROID_ABI=@ANDROID_ABI@" "ANDROID_PLATFORM=android-@BEAM_TARGET_MINIMUM@" "ANDROID_STL=c++_shared")
    string(REPLACE "=" ";" _parts "${_pair}")
    list(GET _parts 0 _key)
    list(GET _parts 1 _value)
    if(DEFINED ${_key} AND NOT "${${_key}}" STREQUAL "${_value}")
        message(FATAL_ERROR "${_key} differs from selected BEAM SDK")
    endif()
    set(${_key} "${_value}" CACHE STRING "Selected BEAM Android SDK" FORCE)
endforeach()
if(DEFINED CMAKE_ANDROID_NDK)
    file(REAL_PATH "${CMAKE_ANDROID_NDK}" _other_ndk)
    if(NOT _other_ndk STREQUAL _beam_ndk)
        message(FATAL_ERROR "CMake selected a different Android NDK")
    endif()
endif()
include("${_beam_ndk}/build/cmake/android.toolchain.cmake")
get_filename_component(_beam_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(BEAM_DIR "${_beam_prefix}/lib/cmake/BEAM" CACHE PATH "Selected BEAM target" FORCE)
# AGP supplies Prefab roots: retain them rather than replacing its search graph.
list(APPEND CMAKE_FIND_ROOT_PATH "${_beam_prefix}")
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
