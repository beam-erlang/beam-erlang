# Optional application deployment support. Declarations package assets only;
# runtime selection, activation and lifecycle remain explicit in application C.
include_guard(GLOBAL)

function(beam_target_deployment target)
    cmake_parse_arguments(PARSE_ARGV 1 DEP "" "PROFILE" "COMPONENTS")
    if(DEP_UNPARSED_ARGUMENTS OR DEP_KEYWORDS_MISSING_VALUES OR
       NOT DEP_PROFILE MATCHES "^(bare|base|components|beam-returning)$")
        message(FATAL_ERROR "${target}: require PROFILE bare, base, components, or beam-returning")
    endif()
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "${target}: deployment requires an executable target")
    endif()
    get_target_property(_type "${target}" TYPE)
    get_target_property(_existing "${target}" BEAM_DEPLOY_PROFILE)
    if(NOT _type STREQUAL "EXECUTABLE" OR _existing)
        message(FATAL_ERROR "${target}: declare deployment once on an executable")
    endif()
    if(DEP_COMPONENTS AND NOT DEP_PROFILE MATCHES "^(components|beam-returning)$")
        message(FATAL_ERROR "${target}: COMPONENTS requires components or beam-returning")
    endif()
    get_filename_component(_prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../.." ABSOLUTE)
    set(_artifacts runtime)
    set(_inventories)
    if(NOT DEP_PROFILE STREQUAL "bare")
        list(APPEND _inventories base)
    endif()
    if(DEP_PROFILE MATCHES "^(components|beam-returning)$")
        if(DEP_PROFILE STREQUAL "beam-returning")
            list(APPEND _inventories boot)
        endif()
        list(APPEND _inventories services)
        foreach(_component IN LISTS DEP_COMPONENTS)
            if(_component MATCHES "^(file|network|zlib)$")
                list(APPEND _artifacts "library.${_component}.shared")
            elseif(_component STREQUAL "program")
                list(APPEND _artifacts helper.child_setup)
            else()
                message(FATAL_ERROR "${target}: unknown component ${_component}")
            endif()
        endforeach()
    endif()
    _beam_runtime_artifact_closure(_closure ${_artifacts})
    set(_files)
    set(_expected_files)
    set(_directories)
    foreach(_artifact IN LISTS _closure)
        _beam_artifact_json(_relative artifacts "${_artifact}" path)
        _beam_artifact_json(_hash artifacts "${_artifact}" sha256)
        list(APPEND _files "${_relative}")
        list(APPEND _expected_files "${_relative}|${_hash}")
    endforeach()
    foreach(_inventory IN LISTS _inventories)
        beam_check_bytecode_inventory("${_inventory}")
        string(TOUPPER "${_inventory}" _upper)
        string(SUBSTRING "${_inventory}" 0 1 _initial)
        string(TOUPPER "${_initial}" _initial)
        string(SUBSTRING "${_inventory}" 1 -1 _rest)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BEAM${_initial}${_rest}Inventory.cmake")
        foreach(_record IN LISTS BEAM_${_upper}_EXPECTED_RECORDS)
            string(REPLACE "|" ";" _fields "${_record}")
            list(GET _fields 0 _relative)
            list(GET _fields 2 _hash)
            list(APPEND _files "${_relative}")
            list(APPEND _expected_files "${_relative}|${_hash}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _expected_files)
    foreach(_asset IN LISTS _files)
        if(_asset MATCHES "^(.+[.]framework)/")
            list(APPEND _directories "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _files)
    list(REMOVE_DUPLICATES _directories)
    foreach(_asset IN LISTS _files _directories)
        if(NOT EXISTS "${_prefix}/${_asset}")
            message(FATAL_ERROR "${target}: selected deployment asset is missing: ${_prefix}/${_asset}")
        endif()
    endforeach()
    string(MAKE_C_IDENTIFIER "${target}" BEAM_DEPLOY_ID)
    string(TOUPPER "${BEAM_DEPLOY_ID}" BEAM_DEPLOY_MACRO)
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/beam-deployment/${target}")
    file(MAKE_DIRECTORY "${_output}")
    set(_header "/* Generated application deployment locations; no runtime policy. */\n#ifndef ${BEAM_DEPLOY_MACRO}_DEPLOYMENT_H\n#define ${BEAM_DEPLOY_MACRO}_DEPLOYMENT_H\n")
    foreach(_asset IN LISTS _files _directories)
        string(MAKE_C_IDENTIFIER "${_asset}" _key)
        string(TOUPPER "${_key}" _key)
        set(_deployed "${_asset}")
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            string(REGEX REPLACE "^lib/(.+[.]framework)(/.*)?$" "Frameworks/\\1\\2" _deployed "${_asset}")
        endif()
        string(APPEND _header "#define ${BEAM_DEPLOY_MACRO}_${_key} \"${_deployed}\"\n")
    endforeach()
    string(APPEND _header "#endif\n")
    file(CONFIGURE OUTPUT "${_output}/${BEAM_DEPLOY_ID}_deployment.h" CONTENT "${_header}" NEWLINE_STYLE UNIX @ONLY)
    target_include_directories(${target} PRIVATE "${_output}")
    set_target_properties(${target} PROPERTIES BEAM_DEPLOY_PROFILE "${DEP_PROFILE}"
        BEAM_DEPLOY_FILES "${_files}" BEAM_DEPLOY_DIRECTORIES "${_directories}"
        BEAM_DEPLOY_PREFIX "${_prefix}" BEAM_DEPLOY_EXPECTED_FILES "${_expected_files}")
endfunction()

function(beam_install_deployment target)
    get_target_property(_profile ${target} BEAM_DEPLOY_PROFILE)
    get_target_property(_installed ${target} BEAM_DEPLOY_INSTALLED)
    if(NOT _profile OR _installed)
        message(FATAL_ERROR "${target}: declare deployment first and install it once")
    endif()
    get_target_property(_expected_files ${target} BEAM_DEPLOY_EXPECTED_FILES)
    get_target_property(_directories ${target} BEAM_DEPLOY_DIRECTORIES)
    get_target_property(_prefix ${target} BEAM_DEPLOY_PREFIX)
    set(_rpath "$ORIGIN/../lib")
    if(APPLE)
        set(_rpath "@executable_path/../lib")
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            set(_rpath "@executable_path/Frameworks")
        endif()
    endif()
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "${_rpath}"
        INSTALL_RPATH_USE_LINK_PATH FALSE BEAM_DEPLOY_INSTALLED TRUE)
    install(TARGETS ${target} RUNTIME DESTINATION bin BUNDLE DESTINATION .)
    foreach(_record IN LISTS _expected_files)
        string(REPLACE "|" ";" _fields "${_record}")
        list(GET _fields 0 _asset)
        list(GET _fields 1 _expected)
        get_filename_component(_directory "${_asset}" DIRECTORY)
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            set(_directory "${target}.app/${_directory}")
        endif()
        set(_mode)
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS" AND _asset MATCHES "[.]framework/")
            set(_mode VERIFY_ONLY) # Install the complete framework below.
        elseif(_asset MATCHES "^libexec/")
            set(_mode PROGRAM)
        endif()
        _beam_install_verified_file("${_prefix}/${_asset}" "${_expected}" "${_directory}"
            "BEAM deployment asset changed after configuration: ${_asset}" ${_mode})
    endforeach()
    foreach(_directory IN LISTS _directories)
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS" AND _directory MATCHES "[.]framework$")
            install(DIRECTORY "${_prefix}/${_directory}" DESTINATION "${target}.app/Frameworks")
        else()
            install(DIRECTORY "${_prefix}/${_directory}/" DESTINATION "${_directory}")
        endif()
    endforeach()
endfunction()
