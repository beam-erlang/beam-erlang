# Producer expectations are derived from verified build outputs, never from an
# installed prefix supplied by a consumer.
foreach(_required IN ITEMS NAME BUILD_ID MODULES INPUT_DIR OUTPUT_DIR RELATIVE_ROOT)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "${_required} is required")
    endif()
endforeach()
if(NOT NAME MATCHES "^(base|boot|services|startup|host|output|code)$")
    message(FATAL_ERROR "Unknown ordinary bytecode inventory: ${NAME}")
endif()
string(TOUPPER "${NAME}" _upper)
string(SUBSTRING "${NAME}" 0 1 _initial)
string(TOUPPER "${_initial}" _initial)
string(SUBSTRING "${NAME}" 1 -1 _rest)
set(_title "${_initial}${_rest}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(_header "/* Generated from verified distribution bytecode. */\nstatic const char beam_${NAME}_manifest[] =\n")
set(_manifest "")
foreach(_module IN LISTS MODULES)
    if(NOT _module MATCHES "^[a-z][a-zA-Z0-9_]*$")
        message(FATAL_ERROR "Invalid inventory module: ${_module}")
    endif()
    string(APPEND _manifest "${_module}\n")
    string(APPEND _header "    \"${_module}\\n\"\n")
endforeach()
string(APPEND _header ";\nstatic const beam_bytecode_record beam_${NAME}_records[] = {\n")
set(_cmake "# Generated producer expectations; consumer configuration must only verify.\nset(BEAM_${_upper}_EXPECTED_BUILD_ID \"${BUILD_ID}\")\nset(BEAM_${_upper}_EXPECTED_RECORDS\n")
string(SHA256 _manifest_hash "${_manifest}")
string(LENGTH "${_manifest}" _manifest_size)
string(APPEND _cmake "    \"${RELATIVE_ROOT}/modules.txt|${_manifest_size}|${_manifest_hash}\"\n")
foreach(_module IN LISTS MODULES)
    file(SIZE "${INPUT_DIR}/${_module}.beam" _size)
    file(SHA256 "${INPUT_DIR}/${_module}.beam" _sha256)
    string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_sha256}")
    set(_relative "${RELATIVE_ROOT}/ebin/${_module}.beam")
    string(APPEND _header "    {\"${_module}\", \"${_relative}\", ${_size}, {${_bytes}}},\n")
    string(APPEND _cmake "    \"${_relative}|${_size}|${_sha256}\"\n")
endforeach()
list(LENGTH MODULES _count)
string(APPEND _header "};\nstatic const beam_bytecode_inventory beam_${NAME}_inventory = {\n    \"${BUILD_ID}\", ${_count}, beam_${NAME}_records\n};\n")
string(APPEND _cmake ")\n")
file(CONFIGURE OUTPUT "${OUTPUT_DIR}/beam_${NAME}_inventory.inc" CONTENT "${_header}" NEWLINE_STYLE UNIX @ONLY)
file(CONFIGURE OUTPUT "${OUTPUT_DIR}/BEAM${_title}Inventory.cmake" CONTENT "${_cmake}" NEWLINE_STYLE UNIX @ONLY)
file(CONFIGURE OUTPUT "${OUTPUT_DIR}/${NAME}-modules.txt" CONTENT "${_manifest}" NEWLINE_STYLE UNIX @ONLY)
