# Build/export-time ELF validation. Executes only the explicitly selected NDK host tool.
cmake_minimum_required(VERSION 3.25)
include("${BEAM_ANDROID_NATIVE_INPUTS}")
if(NOT DEFINED ENV{ANDROID_NDK_ROOT})
    message(FATAL_ERROR "Select ANDROID_NDK_ROOT for Android native verification")
endif()
file(STRINGS "$ENV{ANDROID_NDK_ROOT}/source.properties" _revision REGEX "^Pkg.Revision")
if(NOT _revision MATCHES "^Pkg.Revision[ =]+28\\.2\\.13676358 *$")
    message(FATAL_ERROR "Android native verification requires NDK 28.2.13676358")
endif()
file(GLOB _readelf "$ENV{ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/*/bin/llvm-readelf${CMAKE_EXECUTABLE_SUFFIX}")
list(LENGTH _readelf _count)
if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Selected NDK must provide one host llvm-readelf")
endif()
if(BEAM_ANDROID_ABI STREQUAL "arm64-v8a")
    set(_machine "AArch64")
elseif(BEAM_ANDROID_ABI STREQUAL "x86_64")
    set(_machine "Advanced Micro Devices X86-64")
else()
    message(FATAL_ERROR "Unsupported Android ABI")
endif()
set(_allowed libc.so libm.so libdl.so libandroid.so liblog.so libbeam.so libc++_shared.so)
set(_system libc.so libm.so libdl.so libandroid.so liblog.so)
set(_names)
foreach(_file IN LISTS BEAM_ANDROID_NATIVE_FILES)
    get_filename_component(_name "${_file}" NAME)
    if(_name IN_LIST _system OR _name IN_LIST _names OR _name MATCHES "^(libbeam(-file|-network|-zlib)?|libc\\+\\+_shared)\\.so$")
        message(FATAL_ERROR "Conflicting Android native library: ${_name}")
    endif()
    list(APPEND _names "${_name}")
    if(_name MATCHES "\\.so$")
        list(APPEND _allowed "${_name}")
    endif()
endforeach()
foreach(_file IN LISTS BEAM_ANDROID_NATIVE_FILES)
    get_filename_component(_name "${_file}" NAME)
    execute_process(COMMAND "${_readelf}" -h -l -d -W "${_file}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _elf ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Invalid Android native artifact ${_name}: ${_error}")
    endif()
    string(REGEX MATCHALL "Machine:[^\n]*" _machines "${_elf}")
    if(NOT _machines)
        message(FATAL_ERROR "Native artifact has no ELF objects: ${_name}")
    endif()
    foreach(_entry IN LISTS _machines)
        string(REGEX REPLACE "^Machine: *" "" _entry "${_entry}")
        string(STRIP "${_entry}" _entry)
        if(NOT _entry STREQUAL _machine)
            message(FATAL_ERROR "Native artifact ABI mismatch: ${_name}")
        endif()
    endforeach()
    if(_name MATCHES "\\.so$")
        string(REGEX MATCHALL "\\(SONAME\\)[^\n]*\\[([^]]+)\\]" _sonames "${_elf}")
        list(LENGTH _sonames _count)
        string(REGEX REPLACE ".*\\[([^]]+)\\]" "\\1" _soname "${_sonames}")
        if(NOT _count EQUAL 1 OR NOT _soname STREQUAL _name)
            message(FATAL_ERROR "Android shared artifact requires its basename as SONAME: ${_name}")
        endif()
        string(REGEX MATCHALL "LOAD[^\n]*" _loads "${_elf}")
        if(NOT _loads)
            message(FATAL_ERROR "Android shared artifact has no load segments: ${_name}")
        endif()
        if(NOT _elf MATCHES "Type: +DYN")
            message(FATAL_ERROR "Android shared artifact is not ET_DYN: ${_name}")
        endif()
        foreach(_load IN LISTS _loads)
            string(REGEX MATCHALL "0x[0-9a-fA-F]+" _fields "${_load}")
            list(LENGTH _fields _count)
            if(NOT _count EQUAL 6)
                message(FATAL_ERROR "Malformed Android ELF load segment: ${_name}")
            endif()
            list(GET _fields 0 _offset)
            list(GET _fields 1 _address)
            list(GET _fields 3 _file_size)
            list(GET _fields 4 _memory_size)
            list(GET _fields 5 _alignment)
            math(EXPR _power "${_alignment} & (${_alignment} - 1)")
            math(EXPR _congruence "(${_address} - ${_offset}) % 16384")
            if(_alignment LESS 16384 OR NOT _power EQUAL 0 OR NOT _congruence EQUAL 0 OR _file_size GREATER _memory_size)
                message(FATAL_ERROR "Android library is not 16 KB compatible: ${_name}")
            endif()
            string(REGEX REPLACE "0x[0-9a-fA-F]+|LOAD" "" _flags "${_load}")
            if(_flags MATCHES "W" AND _flags MATCHES "E")
                message(FATAL_ERROR "Writable executable Android ELF segment: ${_name}")
            endif()
        endforeach()
        string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[([^]]+)\\]" _needed "${_elf}")
        foreach(_entry IN LISTS _needed)
            string(REGEX REPLACE ".*\\[([^]]+)\\]" "\\1" _dependency "${_entry}")
            if(NOT _dependency IN_LIST _allowed)
                message(FATAL_ERROR "Unsupported Android ELF dependency: ${_name} -> ${_dependency}")
            endif()
        endforeach()
        string(REGEX MATCHALL "\\((RPATH|RUNPATH)\\)[^\n]*\\[([^]]*)\\]" _paths "${_elf}")
        foreach(_entry IN LISTS _paths)
            string(REGEX REPLACE ".*\\[([^]]*)\\]" "\\1" _path "${_entry}")
            if(NOT _path STREQUAL "" AND NOT _path STREQUAL "$ORIGIN" AND NOT _path STREQUAL "\${ORIGIN}")
                message(FATAL_ERROR "Unsupported Android ELF search path: ${_name}")
            endif()
        endforeach()
    elseif(NOT _name MATCHES "\\.a$")
        message(FATAL_ERROR "Unsupported Android native artifact kind: ${_name}")
    endif()
endforeach()
