# Combine producer-verified expectations into one private host implementation.
set(_source "/* Generated from verified distribution bytecode. */\n#include <beam/sdk/inventories.h>\n\n")
foreach(_kind IN ITEMS base boot services startup host output code)
    file(READ "${INPUT_DIR}/beam_${_kind}_inventory.inc" _fragment)
    string(APPEND _source "${_fragment}\n")
endforeach()
string(APPEND _source "static const beam_sdk_inventory inventories[] = {\n")
foreach(_kind IN ITEMS base boot services startup host output code)
    set(_directory "${_kind}")
    if(_kind STREQUAL "base")
        set(_directory library)
    endif()
    string(APPEND _source "    {&beam_${_kind}_inventory, \"lib/beam/${_directory}/modules.txt\", {(const unsigned char *)beam_${_kind}_manifest, sizeof(beam_${_kind}_manifest)-1}},\n")
endforeach()
string(APPEND _source "};\n\nconst beam_sdk_inventory *beam_sdk_inventory_get(beam_sdk_inventory_kind kind)\n{\n    switch (kind) {\n    case BEAM_SDK_INVENTORY_BASE: return &inventories[0];\n    case BEAM_SDK_INVENTORY_BOOT: return &inventories[1];\n    case BEAM_SDK_INVENTORY_SERVICES: return &inventories[2];\n    case BEAM_SDK_INVENTORY_STARTUP: return &inventories[3];\n    case BEAM_SDK_INVENTORY_HOST: return &inventories[4];\n    case BEAM_SDK_INVENTORY_OUTPUT: return &inventories[5];\n    case BEAM_SDK_INVENTORY_CODE: return &inventories[6];\n    default: return NULL;\n    }\n}\n")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${_source}" NEWLINE_STYLE UNIX @ONLY)
