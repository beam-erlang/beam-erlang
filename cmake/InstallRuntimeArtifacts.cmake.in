# Inventory installed matching-build runtime artifacts after install-time RPATH
# changes. Applications and Erlang startup inventories belong to consumers.
set(_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_records @BEAM_RUNTIME_ARTIFACT_RECORDS@)
file(SHA256 "${_root}/lib/beam/sdk.toml" _metadata_hash)
set(_json "{\n  \"format\": 1,\n  \"version\": \"@PROJECT_VERSION@\",\n  \"flavor\": \"@ERTS_BUILD_FLAVOR@\",\n  \"build-id\": \"@BEAM_COMPONENT_BUILD_ID@\",\n  \"architecture\": \"@CMAKE_SYSTEM_PROCESSOR@\",\n  \"triple\": \"@ERTS_HOST_TRIPLE@\",\n  \"sdk-metadata-sha256\": \"${_metadata_hash}\",\n  \"artifacts\": {")
set(_separator "")
string(TOLOWER "${CMAKE_INSTALL_CONFIG_NAME}" _configuration)
foreach(_record IN LISTS _records)
    string(REPLACE "|" ";" _fields "${_record}")
    list(GET _fields 0 _id)
    list(GET _fields 1 _kind)
    list(GET _fields 2 _path)
    string(REPLACE "%CONFIG%" "${_configuration}" _path "${_path}")
    list(GET _fields 3 _dependencies)
    file(SHA256 "${_root}/${_path}" _hash)
    string(REPLACE "," "\", \"" _dependencies "${_dependencies}")
    if(_dependencies STREQUAL "-")
        set(_dependencies "")
    else()
        set(_dependencies "\"${_dependencies}\"")
    endif()
    string(APPEND _json "${_separator}\n    \"${_id}\": {\"kind\": \"${_kind}\", \"path\": \"${_path}\", \"sha256\": \"${_hash}\", \"requires\": [${_dependencies}]}")
    set(_separator ",")
endforeach()
string(APPEND _json "\n  }\n}\n")
file(WRITE "${_root}/lib/beam/runtime-artifacts.json" "${_json}")
