include_guard(GLOBAL)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS ON)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
if(NOT CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|Debug)$")
    message(FATAL_ERROR "Use Release, RelWithDebInfo or Debug")
endif()
set(ERTS_BUILD_FLAVOR jit CACHE STRING "Runtime flavor")
set_property(CACHE ERTS_BUILD_FLAVOR PROPERTY STRINGS emu jit)
if(NOT ERTS_BUILD_FLAVOR MATCHES "^(emu|jit)$")
    message(FATAL_ERROR "ERTS_BUILD_FLAVOR must be emu or jit")
endif()
option(BEAM_RELEASE_DEBUG_INFO "Retain release debug information" OFF)
option(BEAM_HOST_TOOLS_ONLY "Private native bootstrap build" OFF)
set(BEAM_HOST_TOOLS_ROOT "" CACHE PATH "Verified native host-tools build directory")
set(BEAM_SANITIZERS "" CACHE STRING "Semicolon-separated compiler sanitizers")
if(BEAM_RELEASE_DEBUG_INFO)
    if(MSVC)
        add_compile_options(/Z7)
        add_link_options(/DEBUG)
    else()
        add_compile_options(-g)
    endif()
endif()
if(BEAM_SANITIZERS)
    if(MSVC)
        message(FATAL_ERROR "Sanitizer presets require GCC or Clang")
    endif()
    list(JOIN BEAM_SANITIZERS "," _sanitizers)
    add_compile_options("-fsanitize=${_sanitizers}" -fno-omit-frame-pointer)
    add_link_options("-fsanitize=${_sanitizers}")
endif()
set(ERTS_ZLIB_VENDORED ON)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/erts/beam_release_version.h"
    CONTENT "#define BEAM_RELEASE_VERSION \"${BEAM_RELEASE_VERSION}\"\n" @ONLY)
