include_guard(GLOBAL)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS ON)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
if(NOT CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|Debug)$")
    message(FATAL_ERROR "Use Release, RelWithDebInfo or Debug")
endif()
set(ERTS_BUILD_FLAVOR jit CACHE STRING "Runtime flavor")
set_property(CACHE ERTS_BUILD_FLAVOR PROPERTY STRINGS emu jit)
if(NOT ERTS_BUILD_FLAVOR MATCHES "^(emu|jit)$")
    message(FATAL_ERROR "ERTS_BUILD_FLAVOR must be emu or jit")
endif()
option(BEAM_RELEASE_DEBUG_INFO "Retain release debug information" OFF)
option(BEAM_HOST_TOOLS_ONLY "Private native bootstrap build" OFF)
set(BEAM_HOST_TOOLS_ROOT "" CACHE PATH "Verified native host-tools build directory")
set(BEAM_SANITIZERS "" CACHE STRING "Semicolon-separated compiler sanitizers")
set(BEAM_PRIVATE_COMPILE_OPTIONS)
set(BEAM_PRIVATE_LINK_OPTIONS)
if(BEAM_RELEASE_DEBUG_INFO)
    if(MSVC)
        list(APPEND BEAM_PRIVATE_COMPILE_OPTIONS /Z7)
        list(APPEND BEAM_PRIVATE_LINK_OPTIONS /DEBUG)
    else()
        list(APPEND BEAM_PRIVATE_COMPILE_OPTIONS -g)
    endif()
endif()
if(BEAM_SANITIZERS)
    if(MSVC)
        message(FATAL_ERROR "Sanitizer presets require GCC or Clang")
    endif()
    list(JOIN BEAM_SANITIZERS "," _sanitizers)
    list(APPEND BEAM_PRIVATE_COMPILE_OPTIONS
        "-fsanitize=${_sanitizers}" -fno-omit-frame-pointer)
    list(APPEND BEAM_PRIVATE_LINK_OPTIONS "-fsanitize=${_sanitizers}")
endif()
set(ERTS_ZLIB_VENDORED ON)

# Build options are private to compiled producer targets, including native host
# tools and tests. Direct properties keep them out of installed target exports.
function(beam_apply_build_options target)
    get_target_property(_beam_alias "${target}" ALIASED_TARGET)
    get_target_property(_beam_imported "${target}" IMPORTED)
    get_target_property(_beam_type "${target}" TYPE)
    get_property(_beam_applied TARGET "${target}" PROPERTY BEAM_PRIVATE_BUILD_OPTIONS_APPLIED)
    if(_beam_alias OR _beam_imported OR _beam_applied OR
            NOT _beam_type MATCHES "^(EXECUTABLE|OBJECT_LIBRARY|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY)$")
        return()
    endif()
    # Directory options previously preceded target-specific options. Preserve
    # that order when applying them after all targets have been declared.
    if(BEAM_PRIVATE_COMPILE_OPTIONS)
        target_compile_options("${target}" BEFORE PRIVATE ${BEAM_PRIVATE_COMPILE_OPTIONS})
    endif()
    if(BEAM_PRIVATE_LINK_OPTIONS)
        target_link_options("${target}" BEFORE PRIVATE ${BEAM_PRIVATE_LINK_OPTIONS})
    endif()
    set_property(TARGET "${target}" PROPERTY BEAM_PRIVATE_BUILD_OPTIONS_APPLIED TRUE)
endfunction()

# Call once after the complete project, including optional tests, is assembled.
function(beam_apply_directory_build_options directory)
    get_property(_beam_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_beam_target IN LISTS _beam_targets)
        beam_apply_build_options("${_beam_target}")
    endforeach()
    get_property(_beam_subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_beam_subdirectory IN LISTS _beam_subdirectories)
        beam_apply_directory_build_options("${_beam_subdirectory}")
    endforeach()
endfunction()
