pred.is_mfa_instruction(M, F, A) {
    return beam_builtin_selected_instruction(M.val,F.val,A.val) >= 0;
}

pred.is_mfa_bif(M, F, A) {
    const Export *e;

    ASSERT(M.type == TAG_a && F.type == TAG_a && A.type == TAG_u);
    e = erts_active_export_entry(M.val, F.val, A.val);

    if (e != NULL) {
        return e->bif_number != -1;
    }

    return 0;
}

pred.consecutive_words(S1, D1, S2, D2) {
    return S1.type == S2.type && S1.val + 1 == S2.val &&
	D1.type == D2.type && D1.val + 1 == D2.val;
}

// Test whether we are loading a module with line-breakpoint support
pred.instrumenting_line_breakpoints() {
    return ERTS_DEBUGGER_IS_ENABLED_IN(S->load_hdr->debugger_flags,
                                       ERTS_DEBUGGER_LINE_BREAKPOINTS);
}

pred.never_fails(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->primitive_imports[Bif.val]) & BEAM_NATIVE_NOFAIL) != 0;
}

pred.is_eq_exact_bif(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->primitive_imports[Bif.val]) & BEAM_NATIVE_EQ_EXACT) != 0;
}

pred.is_ne_exact_bif(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->primitive_imports[Bif.val]) & BEAM_NATIVE_NE_EXACT) != 0;
}

pred.is_ge_bif(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->primitive_imports[Bif.val]) & BEAM_NATIVE_GE) != 0;
}

pred.is_lt_bif(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->primitive_imports[Bif.val]) & BEAM_NATIVE_LT) != 0;
}

pred.is_exit_bif(Bif) {
    if (Bif.type != TAG_u || Bif.val >= S->beam.imports.count) return 0;
    return (beam_builtin_entry_traits(S->bif_imports[Bif.val]) & BEAM_NATIVE_NO_RETURN) != 0;
}
