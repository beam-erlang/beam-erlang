BEAM_NATIVE_TRAITS(vm_seq_2, BEAM_NATIVE_NOFAIL | BEAM_NATIVE_EQ_EXACT)
BEAM_NATIVE_TRAITS(vm_sle_2, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_seqeq_2, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_sgt_2, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_sge_2, BEAM_NATIVE_NOFAIL | BEAM_NATIVE_GE)
BEAM_NATIVE_TRAITS(vm_is_atom_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_boolean_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_binary_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_bitstring_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_float_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_integer_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_list_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_map_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_number_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_pid_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_port_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_reference_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_tuple_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_is_function_1, BEAM_NATIVE_NOFAIL)
BEAM_NATIVE_TRAITS(vm_error_1, BEAM_NATIVE_NO_RETURN | BEAM_NATIVE_HIDE_EXCEPTION_FRAME)
BEAM_NATIVE_TRAITS(vm_error_2, BEAM_NATIVE_NO_RETURN | BEAM_NATIVE_HIDE_EXCEPTION_FRAME)
BEAM_NATIVE_TRAITS(vm_error_3, BEAM_NATIVE_NO_RETURN | BEAM_NATIVE_HIDE_EXCEPTION_FRAME)
