# Private installed-fixture observations; never installed as an SDK interface.
function(beam_test_observe target)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/host_observe.c")
    endif()
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    beam_get_runtime_artifact(_runtime NAME runtime)
    get_filename_component(_prefix "${BEAM_SDK_METADATA}" DIRECTORY)
    get_filename_component(_prefix "${_prefix}/../.." ABSOLUTE)
    file(RELATIVE_PATH _relative "${_prefix}" "${_runtime}")
    target_compile_definitions(${target} PRIVATE BEAM_TEST_RUNTIME_RELATIVE="${_relative}")
    foreach(_component file network zlib)
        beam_get_runtime_artifact(_path NAME library.${_component}.shared)
        file(RELATIVE_PATH _relative "${_prefix}" "${_path}")
        string(TOUPPER "${_component}" _upper)
        target_compile_definitions(${target} PRIVATE BEAM_TEST_${_upper}_RELATIVE="${_relative}")
    endforeach()
endfunction()
