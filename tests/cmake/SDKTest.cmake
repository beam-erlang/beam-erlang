# CMake's Windows DESTDIR manifest drops the drive. Compare logical paths in
# that same form, case-insensitively, while retaining Unicode path bytes.
function(sdk_normalize_manifest_path input output)
    file(TO_CMAKE_PATH "${input}" _path)
    cmake_path(SET _path NORMALIZE "${_path}")
    if(TARGET_SYSTEM STREQUAL "Windows")
        if(_path MATCHES "^[A-Za-z]:(.*)$")
            set(_path "${CMAKE_MATCH_1}")
        endif()
        string(TOLOWER "${_path}" _path)
    endif()
    set(${output} "${_path}" PARENT_SCOPE)
endfunction()

function(sdk_command label expected_status)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${_payload}/work" INPUT_FILE "${_null_input}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
    file(WRITE "${TEST_ROOT}/${label}.log" "${_out}${_err}")
    if(expected_status STREQUAL "failure")
        if("${_status}" STREQUAL "0")
            message(FATAL_ERROR "${label}: unexpectedly succeeded. Evidence: ${TEST_ROOT}")
        endif()
    elseif(NOT "${_status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${label}: expected status ${expected_status}, got ${_status}. Evidence: ${TEST_ROOT}\n${_out}${_err}")
    endif()
    set(SDK_COMMAND_OUTPUT "${_out}${_err}" PARENT_SCOPE)
endfunction()

