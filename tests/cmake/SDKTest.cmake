    set(_boot_args -S 2:2 -SDcpu 1 -SDio 1 -- -root "${_bundle}/fixture"
        -bindir "${_bundle}/bin" -progname beam_sdk_${_language}
        -boot "${_bundle}/fixture/bin/start_clean" -noshell -noinput -no_dot_erlang)
    sdk_command(${_language}-native 0 "${_host}" ${_boot_args}
        -eval "${_eval}" -extra "${_bundle}" "${EXPECTED_FLAVOR}" "${EXPECTED_HOST_TRIPLE}"
        "${EXPECTED_VERSION}" "${EXPECTED_BUILD_TYPE}")
    if(NOT SDK_COMMAND_OUTPUT MATCHES "sdk_consumer_ok")
        message(FATAL_ERROR "Missing ${_language} native acceptance marker")
    endif()
    if(TARGET_SYSTEM STREQUAL "Linux" AND NOT SDK_COMMAND_OUTPUT MATCHES "sdk_affinity,restored")
        message(FATAL_ERROR "Missing ${_language} self-process affinity acceptance marker")
    endif()
    # /dev/null as readable stdin exercises the real TTY fallback pollset.
    set(_stdin_args ${_boot_args})
    list(REMOVE_ITEM _stdin_args -noinput)
    sdk_command(${_language}-stdin-eof 0 "${_host}" ${_stdin_args}
        -eval "eof=io:get_line(\"\"),io:put_chars(\"sdk_stdin_eof_ok\"),erlang:halt(0).")
    if(NOT SDK_COMMAND_OUTPUT STREQUAL "sdk_stdin_eof_ok")
        message(FATAL_ERROR "Unexpected ${_language} stdin EOF output: ${SDK_COMMAND_OUTPUT}")
    endif()
    sdk_command(${_language}-halt 23 "${_host}" ${_boot_args}
        -eval "erlang:halt(23).")
endforeach()
message(STATUS "Installed C/C++ SDK consumers passed (${EXPECTED_FLAVOR}, ${EXPECTED_BUILD_TYPE}; ${EXPECTED_BUILD_ID})")
file(REMOVE_RECURSE "${TEST_ROOT}")
