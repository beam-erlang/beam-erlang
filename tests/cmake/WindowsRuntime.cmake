# Debug builds use MSVC's DLL CRT. Those compiler runtime DLLs live beside the
# selected toolchain/Windows SDK, rather than in System32. Permit only their
# discovered directories in isolated tests; no producer VM or OTP paths enter
# the loader search, and these developer DLLs are not installed with the product.
function(beam_test_windows_runtime_directories output)
    set(_directories)
    if(MSVC AND BEAM_SDK_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDebugDLL")
        set(CMAKE_INSTALL_DEBUG_LIBRARIES TRUE)
        set(CMAKE_INSTALL_DEBUG_LIBRARIES_ONLY TRUE)
        set(CMAKE_INSTALL_UCRT_LIBRARIES TRUE)
        set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
        set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
        include(InstallRequiredSystemLibraries)
        set(_have_vcruntime FALSE)
        set(_have_ucrt FALSE)
        foreach(_library IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
            if(EXISTS "${_library}")
                get_filename_component(_directory "${_library}" DIRECTORY)
                get_filename_component(_name "${_library}" NAME)
                list(APPEND _directories "${_directory}")
                if(_name MATCHES "^vcruntime[0-9]+d\\.dll$")
                    set(_have_vcruntime TRUE)
                elseif(_name STREQUAL "ucrtbased.dll")
                    set(_have_ucrt TRUE)
                endif()
            endif()
        endforeach()
        if(NOT _have_vcruntime OR NOT _have_ucrt)
            message(FATAL_ERROR "Isolated Windows Debug tests require the selected MSVC and Windows SDK Debug CRT DLLs")
        endif()
        list(REMOVE_DUPLICATES _directories)
    endif()
    # Use a separator that cannot appear in Windows paths so a CTest command
    # argument never splits an embedded PATH list into unrelated arguments.
    string(JOIN "|" _encoded ${_directories})
    set(${output} "${_encoded}" PARENT_SCOPE)
endfunction()

function(beam_test_windows_path system32 encoded_directories output)
    set(_path "${system32}")
    string(REPLACE "|" ";" _directories "${encoded_directories}")
    foreach(_directory IN LISTS _directories)
        if(NOT IS_DIRECTORY "${_directory}")
            message(FATAL_ERROR "Missing selected Windows compiler runtime directory: ${_directory}")
        endif()
        string(APPEND _path ";${_directory}")
    endforeach()
    set(${output} "${_path}" PARENT_SCOPE)
endfunction()
