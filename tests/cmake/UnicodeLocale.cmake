# Keep diagnostics predictable while exercising native Unicode filenames.
function(beam_test_unicode_locale output)
    set(_environment)
    if(TARGET_SYSTEM STREQUAL "Linux")
        find_program(_locale NAMES locale PATHS /usr/bin /bin NO_DEFAULT_PATH REQUIRED)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${_locale}" -a
            RESULT_VARIABLE _status OUTPUT_VARIABLE _available ERROR_VARIABLE _error TIMEOUT 10)
        if(NOT "${_status}" STREQUAL "0")
            message(FATAL_ERROR "Cannot inspect the UTF-8 locale prerequisite: ${_error}")
        endif()
        string(REPLACE "\n" ";" _available "${_available}")
        foreach(_candidate C.UTF-8 C.utf8)
            if(_candidate IN_LIST _available)
                set(_environment "LC_ALL=${_candidate}")
                break()
            endif()
        endforeach()
        if(NOT _environment)
            message(FATAL_ERROR "Runtime and SDK tests require an available C.UTF-8/C.utf8 locale")
        endif()
    endif()
    set(${output} "${_environment}" PARENT_SCOPE)
endfunction()
