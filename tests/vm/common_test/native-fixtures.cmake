cmake_minimum_required(VERSION 3.25)
project(VMNativeFixtures LANGUAGES C)
find_package(BEAM CONFIG REQUIRED COMPONENTS Driver)
find_package(Threads REQUIRED)

if(SUITE STREQUAL "float_SUITE")
    include(CheckSymbolExists)
    check_symbol_exists(isfinite "math.h" HAVE_ISFINITE)
    if(NOT HAVE_ISFINITE)
        message(FATAL_ERROR "The unchanged floating-point driver requires isfinite")
    endif()
    add_library(fp_drv MODULE "${DATA_DIRECTORY}/fp_drv.c")
    target_link_libraries(fp_drv PRIVATE BEAM::Driver Threads::Threads m)
    target_compile_definitions(fp_drv PRIVATE HAVE_ISFINITE=1)
    set_target_properties(fp_drv PROPERTIES PREFIX "" LIBRARY_OUTPUT_DIRECTORY "${DATA_DIRECTORY}")
elseif(SUITE STREQUAL "signal_SUITE")
    add_library(unlink_signal_drv MODULE "${DATA_DIRECTORY}/unlink_signal_drv.c")
    target_link_libraries(unlink_signal_drv PRIVATE BEAM::Driver Threads::Threads)
    set_target_properties(unlink_signal_drv PROPERTIES PREFIX "" LIBRARY_OUTPUT_DIRECTORY "${DATA_DIRECTORY}")
elseif(SUITE STREQUAL "process_SUITE")
    file(GLOB _ei_roots "${OTP_PREFIX}/lib/erlang/lib/erl_interface-*"
                        "${OTP_PREFIX}/lib/erl_interface-*")
    list(LENGTH _ei_roots _ei_count)
    if(NOT _ei_count EQUAL 1)
        message(FATAL_ERROR "Select one installed Erl_Interface application")
    endif()
    list(GET _ei_roots 0 _ei_root)
    find_path(EI_INCLUDE_DIRECTORY ei.h PATHS "${_ei_root}/include" NO_DEFAULT_PATH REQUIRED)
    find_library(EI_LIBRARY ei PATHS "${_ei_root}/lib" NO_DEFAULT_PATH REQUIRED)
    add_executable(fwd_node "${DATA_DIRECTORY}/fwd_node.c")
    target_include_directories(fwd_node PRIVATE "${EI_INCLUDE_DIRECTORY}")
    target_compile_definitions(fwd_node PRIVATE _REENTRANT)
    target_link_libraries(fwd_node PRIVATE "${EI_LIBRARY}" Threads::Threads)
    set_target_properties(fwd_node PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${DATA_DIRECTORY}")
elseif(SUITE STREQUAL "tracer_SUITE")
    add_library(tracer_test MODULE "${DATA_DIRECTORY}/tracer_test.c")
    target_link_libraries(tracer_test PRIVATE BEAM::NIF)
    beam_target_nif(tracer_test)
    set_target_properties(tracer_test PROPERTIES PREFIX "" LIBRARY_OUTPUT_DIRECTORY "${DATA_DIRECTORY}")
elseif(SUITE STREQUAL "seq_trace_SUITE")
    add_library(echo_drv MODULE "${DATA_DIRECTORY}/echo_drv.c")
    target_link_libraries(echo_drv PRIVATE BEAM::Driver Threads::Threads)
    set_target_properties(echo_drv PROPERTIES PREFIX "" LIBRARY_OUTPUT_DIRECTORY "${DATA_DIRECTORY}")
else()
    message(FATAL_ERROR "No native fixture is declared for ${SUITE}")
endif()
